{
  "name": "ascii-things",
  "version": "0.4.0",
  "description": "Living ASCII scenes for the web: sharks, moving robots, jellyfish, and a robot dog.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuma-beep/ascii-things.git"
  },
  "homepage": "https://github.com/chuma-beep/ascii-things#readme",
  "bugs": {
    "url": "https://github.com/chuma-beep/ascii-things/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/ui.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sharks": {
      "types": "./dist/sharks.d.ts",
      "import": "./dist/sharks.js"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "import": "./dist/robots.js"
    },
    "./jellyfish": {
      "types": "./dist/jellyfish.d.ts",
      "import": "./dist/jellyfish.js"
    },
    "./dog": {
      "types": "./dist/dog.d.ts",
      "import": "./dist/dog.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./ui.css": "./dist/ui.css"
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "canvas",
    "simulation",
    "generative",
    "sharks",
    "robots",
    "jellyfish",
    "robot-dog"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup && node scripts/copy-ui-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:all": "npm run check && npm run typecheck && npm test && npm run build && npm run publint && npm run attw && npm run size",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "publint": "publint",
    "attw": "attw --pack .",
    "changeset": "changeset",
    "version": "changeset version",
    "prepublishOnly": "npm run check:all"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.31.1",
    "@size-limit/esbuild": "^12.1.0",
    "@size-limit/file": "^12.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
