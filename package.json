{
  "name": "ascii-things",
  "version": "0.4.0",
  "description": "Living ASCII scenes for the web: sharks, moving robots, jellyfish, and a robot dog.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuma-beep/ascii-things.git"
  },
  "homepage": "https://github.com/chuma-beep/ascii-things#readme",
  "bugs": {
    "url": "https://github.com/chuma-beep/ascii-things/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sharks": {
      "types": "./dist/sharks.d.ts",
      "import": "./dist/sharks.js"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "import": "./dist/robots.js"
    },
    "./jellyfish": {
      "types": "./dist/jellyfish.d.ts",
      "import": "./dist/jellyfish.js"
    },
    "./dog": {
      "types": "./dist/dog.d.ts",
      "import": "./dist/dog.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "canvas",
    "simulation",
    "generative",
    "sharks",
    "robots",
    "jellyfish",
    "robot-dog"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
