---
import CompositionStage from "../../components/CompositionStage.astro";
import DesignIdeaPreview from "../../components/DesignIdeaPreview.astro";
import LogoMark from "../../components/LogoMark.astro";
import { DESIGN_IDEAS, UNIVERSAL_PROMPT } from "../../data/design-ideas";
import "../../styles/design-ideas.css";
import "../../styles/compositions.css";

const [featured, ...rest] = DESIGN_IDEAS;
const title = "Design ideas — ascii-things";
const description =
  "Six living-ASCII layouts to borrow, remix, and hand to your agent. Copy the starter code or the prompt.";
const sceneCount = new Set(
  DESIGN_IDEAS.flatMap((idea) =>
    idea.ingredients
      .filter(
        (item) =>
          item.href.startsWith("/scenes/") || item.href === "/kanji/field/",
      )
      .map((item) => item.name),
  ),
).size;

const searchText = (idea: (typeof DESIGN_IDEAS)[number]) =>
  [idea.title, idea.category, idea.description, idea.note, ...idea.ingredients.map((item) => item.name)]
    .join(" ")
    .toLowerCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3eee4" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://ascii-things-docs.pages.dev/design-ideas/" />
    <meta property="og:site_name" content="ascii-things" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://ascii-things-docs.pages.dev/design-ideas/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/favicon-motion.js" type="module"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="di-header">
      <a class="di-brand" href="/">
        <LogoMark />
        ascii-things <span>/ design ideas</span>
      </a>
      <nav class="di-nav" aria-label="Design ideas">
        <a href="#compositions">Compositions</a>
        <a href="/library/">Library</a>
        <a href="/showcase/">Showcase</a>
        <a href="/image/">Image studio</a>
        <a href="/guide/">Docs</a>
      </nav>
      <span class="di-header__meta">06 recipes / {sceneCount} scenes</span>
    </header>

    <main>
      <section class="di-hero" aria-labelledby="design-ideas-title">
        <div class="di-hero__meta">
          <span>ASCII-THINGS / FIELD NOTES</span>
          <span>VOL. 01 / OCT 2026</span>
          <span>OPEN TO REMIX</span>
        </div>
        <div class="di-hero__grid">
          <div>
            <p class="di-eyebrow">A FIELD GUIDE TO LIVING UI</p>
            <h1 id="design-ideas-title">Design ideas<em>.</em></h1>
          </div>
          <div class="di-hero__copy">
            <p>
              Six layouts built from the same ASCII parts. Take a composition, copy the
              starter code, or hand the prompt to your agent and make it yours.
            </p>
            <p class="di-hero__note">
              <span>BUILT FOR</span>
              Claude Code · Cursor · Codex · a patient human
            </p>
            <p class="di-hero__hint">
              Snippets assume <code>npm install ascii-things</code> and a bundler.
            </p>
          </div>
        </div>
        <div class="di-ticker" aria-label="Available ingredients">
          <span>Robot dog</span>
          <span>Koi</span>
          <span>Servers</span>
          <span>City</span>
          <span>Starlings</span>
          <span>Jellyfish</span>
          <span>Ants</span>
          <span>Fireflies</span>
          <span>Kanji field</span>
          <span>+ your own bad idea</span>
        </div>
      </section>

      <CompositionStage />

      <section class="di-search" aria-labelledby="di-search-title">
        <div class="di-search__scene" data-design-scene aria-hidden="true">
          <template>
            <ascii-sharks
              palette="abyss"
              seed="11"
              density="1.15"
              columns="72"
              max-cells="4200"
              calm
              label="A live shark tank behind the recipe search"
            ></ascii-sharks>
          </template>
        </div>
        <div class="di-search__inner">
          <p class="di-eyebrow">Search the field guide</p>
          <h2 id="di-search-title">What are you <em>building?</em></h2>
          <div class="di-search__form" role="search">
            <label class="di-search__label" for="di-search-input">Search recipes</label>
            <input
              id="di-search-input"
              type="search"
              placeholder="Search recipes, ingredients, prompts…"
              autocomplete="off"
            />
            <p class="di-search__status" id="di-search-status" data-search-status aria-live="polite">
              {DESIGN_IDEAS.length} recipes
            </p>
          </div>
        </div>
      </section>

      <section class="di-featured" data-search={searchText(featured)} id={featured.id} aria-labelledby={`${featured.id}-title`}>
        <a
          class="di-featured__preview"
          href={`/design-ideas/${featured.id}/`}
          aria-label={`Open ${featured.title} as a full page`}
        >
          <DesignIdeaPreview id={featured.id} featured />
          <span class="di-featured__stamp">01 / FEATURED</span>
        </a>
        <div class="di-featured__body">
          <div class="di-meta">
            <span>{featured.number} / {featured.category}</span>
            <span class="di-live">● LIVE PREVIEW</span>
          </div>
          <h2 id={`${featured.id}-title`}>{featured.title}</h2>
          <p class="di-lede">{featured.description}</p>
          <ul class="di-ingredients" aria-label="Ingredients">
            {featured.ingredients.map((ingredient) => (
              <li>
                <a href={ingredient.href}>{ingredient.name}</a>
              </li>
            ))}
          </ul>
          <p class="di-note">{featured.note}</p>
          <div class="di-actions">
            <button
              class="di-copy di-copy--primary"
              type="button"
              data-copy={featured.code}
              data-copy-label={`${featured.title} starter code`}
            >
              Copy starter code
            </button>
            <button
              class="di-copy"
              type="button"
              data-copy={featured.prompt}
              data-copy-label={`${featured.title} prompt`}
            >
              Copy prompt
            </button>
            <a class="di-open-link" href={`/design-ideas/${featured.id}/`}>
              View full page <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="di-grid" aria-label="More design ideas">
        {
          rest.map((idea) => (
            <article class="di-card" data-search={searchText(idea)} id={idea.id}>
              <a
                class="di-card__preview"
                href={`/design-ideas/${idea.id}/`}
                aria-label={`Open ${idea.title} as a full page`}
              >
                <DesignIdeaPreview id={idea.id} />
              </a>
              <div class="di-card__body">
                <div class="di-meta">
                  <span>{idea.number} / {idea.category}</span>
                  <span class="di-live">● LIVE</span>
                </div>
                <h2>{idea.title}</h2>
                <p>{idea.description}</p>
                <ul class="di-ingredients" aria-label="Ingredients">
                  {idea.ingredients.map((ingredient) => (
                    <li>
                      <a href={ingredient.href}>{ingredient.name}</a>
                    </li>
                  ))}
                </ul>
                <p class="di-note">{idea.note}</p>
                <div class="di-actions">
                  <button
                    class="di-copy di-copy--primary"
                    type="button"
                    data-copy={idea.code}
                    data-copy-label={`${idea.title} starter code`}
                  >
                    Copy code
                  </button>
                  <button
                    class="di-copy"
                    type="button"
                    data-copy={idea.prompt}
                    data-copy-label={`${idea.title} prompt`}
                  >
                    Copy prompt
                  </button>
                  <a class="di-open-link" href={`/design-ideas/${idea.id}/`}>
                    View full page <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }

        <article class="di-cta">
          <p class="di-eyebrow">UNIVERSAL BRIEF / 07</p>
          <h2>Now make<br /><em>the seventh.</em></h2>
          <p>
            Start with one scene, one overlay, and one point of view. The brief carries the
            layout rules so your agent can carry the taste.
          </p>
          <button
            class="di-copy di-copy--light"
            type="button"
            data-copy={UNIVERSAL_PROMPT}
            data-copy-label="Universal design prompt"
          >
            Copy the universal prompt
          </button>
          <div class="di-cta__links">
            <a href="/library/">Browse the parts ↗</a>
            <a href="/playground/">Open playground ↗</a>
          </div>
        </article>
      </section>
    </main>

    <footer class="di-footer">
      <span>ascii-things / design ideas</span>
      <span>
        <a href="/library/">All parts ↗</a>
        <a href="/showcase/">Visual archive ↗</a>
      </span>
    </footer>

    <p class="di-toast" data-copy-status role="status" aria-live="polite"></p>

    <script>
      const toast = document.querySelector<HTMLElement>("[data-copy-status]");

      const fallbackCopy = (text: string) => {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.opacity = "0";
        document.body.append(area);
        area.select();
        const copied = document.execCommand("copy");
        area.remove();
        return copied;
      };

      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.dataset.copy;
          if (!text) return;

          let copied = false;
          try {
            await navigator.clipboard.writeText(text);
            copied = true;
          } catch {
            copied = fallbackCopy(text);
          }

          const original = button.textContent ?? "Copy";
          button.textContent = copied ? "Copied" : "Failed";
          button.dataset.copied = copied ? "true" : "false";
          if (toast) {
            toast.textContent = copied
              ? `${button.dataset.copyLabel ?? "Text"} copied.`
              : `Could not copy ${button.dataset.copyLabel ?? "text"}.`;
            toast.dataset.visible = "true";
          }

          window.setTimeout(() => {
            button.textContent = original;
            delete button.dataset.copied;
            if (toast) toast.dataset.visible = "false";
          }, 1900);
        });
      });

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let sceneLoader: Promise<unknown> | undefined;
      const loadScenes = () => (sceneLoader ??= import("ascii-things/element"));

      const mountScene = async (host: HTMLElement) => {
        if (host.dataset.mounted === "true") return;
        host.dataset.mounted = "true";

        try {
          await loadScenes();
        } catch {
          return;
        }

        const template = host.querySelector("template");
        const scene = template?.content.firstElementChild?.cloneNode(true);
        if (!(scene instanceof HTMLElement)) return;

        if (reducedMotion.matches) {
          scene.setAttribute("paused", "");
          scene.setAttribute("calm", "");
        }

        scene.addEventListener(
          "ascii-ready",
          () => {
            host.dataset.live = "true";
          },
          { once: true },
        );
        host.append(scene);
      };

      const sceneHosts = [...document.querySelectorAll<HTMLElement>("[data-design-scene]")];
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              observer.unobserve(entry.target);
              void mountScene(entry.target as HTMLElement);
            }
          },
          { rootMargin: "400px 0px" },
        );

        sceneHosts.forEach((host) => observer.observe(host));
      } else {
        sceneHosts.forEach((host) => void mountScene(host));
      }
    </script>
  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#di-search-input");
    const searchStatus = document.querySelector<HTMLElement>("[data-search-status]");
    const searchable = [...document.querySelectorAll<HTMLElement>("[data-search]")];
    const totalRecipes = searchable.length;

    const applySearch = () => {
      const query = (searchInput?.value ?? "").trim().toLowerCase();
      let shown = 0;
      for (const recipe of searchable) {
        const matches = !query || (recipe.dataset.search ?? "").includes(query);
        recipe.hidden = !matches;
        if (matches) shown++;
      }
      if (searchStatus) {
        searchStatus.textContent = query
          ? `${shown} of ${totalRecipes} recipes`
          : `${totalRecipes} recipes`;
      }
    };

    searchInput?.addEventListener("input", applySearch);
    searchInput?.addEventListener("search", applySearch);
  </script>
  </body>
</html>
