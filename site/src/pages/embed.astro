---
// A chrome-free scene surface for iframe embeds. The page reads its scene and
// shared options from the query string so a single route can host any scene.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>ASCII scene</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #070809;
      }

      #embed-stage {
        position: fixed;
        inset: 0;
      }

      #embed-stage > * {
        display: block;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <div id="embed-stage"></div>
    <script>
      import { mountEmbed } from "../lib/embed-mount";

      mountEmbed();
    </script>
  </body>
</html>
