    <script is:inline>
      const GLYPHS = {
        A: [" ### ", "#   #", "#####", "#   #", "#   #"],
        S: [" ####", "#    ", " ### ", "    #", "#### "],
        C: [" ####", "#    ", "#    ", "#    ", " ####"],
        I: ["#####", "  #  ", "  #  ", "  #  ", "#####"],
        T: ["#####", "  #  ", "  #  ", "  #  ", "  #  "],
        H: ["#   #", "#   #", "#####", "#   #", "#   #"],
        N: ["#   #", "##  #", "# # #", "#  ##", "#   #"],
        G: [" ####", "#    ", "# ###", "#   #", " ####"],
        "-": ["     ", "     ", " ### ", "     ", "     "],
      };

      function hash(value) {
        const raw = Math.sin(value * 12.9898) * 43758.5453;
        return raw - Math.floor(raw);
      }

      function buildRows(word, rowOffset) {
        const rows = Array.from({ length: 5 }, () => []);
        let originSet = false;

        for (let row = 0; row < 5; row++) {
          let col = 0;

          for (let letter = 0; letter < word.length; letter++) {
            const glyph = GLYPHS[word[letter]] || GLYPHS["-"];

            for (let cell = 0; cell < 5; cell++) {
              const on = glyph[row][cell] === "#";
              const origin = on && !originSet;
              if (origin) originSet = true;

              rows[row].push({
                on,
                origin,
                row: row + rowOffset,
                col,
                letter,
              });
              col++;
            }

            if (letter < word.length - 1) {
              rows[row].push({
                on: false,
                origin: false,
                row: row + rowOffset,
                col,
                letter,
              });
              col++;
            }
          }
        }

        for (let row = 0; row < rows.length; row++) {
          for (let col = 0; col < rows[row].length; col++) {
            const index = row * rows[row].length + col;
            rows[row][col].index = index;
            rows[row][col].rand = hash(index + rowOffset * 37 + 1);
          }
        }

        return rows;
      }

      function renderOriginalArt(art) {
        const word = art.dataset.word || "ASCII-THINGS";
        const rows = Array.from({ length: 5 }, (_, row) =>
          [...word].map((char) => (GLYPHS[char] || GLYPHS["-"])[row]).join(" "),
        );
        let index = 0;
        let hasOrigin = false;

        for (const row of rows) {
          const line = document.createElement("span");
          line.className = "orig-line";

          for (const char of row) {
            if (char !== "#") {
              line.appendChild(document.createTextNode(" "));
              continue;
            }

            const cell = document.createElement("span");
            const origin = !hasOrigin;
            if (origin) hasOrigin = true;

            cell.className = "orig-cell" + (origin ? " orig-origin" : "");
            cell.style.setProperty("--i", index++);
            cell.textContent = "█";
            line.appendChild(cell);
          }

          art.appendChild(line);
        }
      }

      function renderArt(art) {
        if (art.dataset.original === "true") {
          renderOriginalArt(art);
          return;
        }

        const word = art.dataset.word || "ASCII-THINGS";
        const rowOffset = Number(art.dataset.rowOffset || 0);
        const rows = buildRows(word, rowOffset);

        for (const row of rows) {
          const line = document.createElement("div");
          line.className = "art-line";

          for (const cell of row) {
            const element = document.createElement("span");
            element.className = "cell" + (cell.on ? " on" : "") + (cell.origin ? " origin" : "");

            if (cell.on) {
              element.style.setProperty("--i", cell.index);
              element.style.setProperty("--col", cell.col);
              element.style.setProperty("--row", cell.row);
              element.style.setProperty("--letter", cell.letter);
              element.style.setProperty("--rand", cell.rand.toFixed(4));

              const block = document.createElement("i");
              element.appendChild(block);
            }

            line.appendChild(element);
          }

          art.appendChild(line);
        }
      }

      document.querySelectorAll(".art").forEach(renderArt);

      function setupHover(stage) {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
        if (reduced.matches) return;

        const cells = [...stage.querySelectorAll(".cell.on")];
        let points = [];
        let frame = 0;

        const measure = () => {
          points = cells.map((cell) => {
            const rect = cell.getBoundingClientRect();
            return { cell, x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
          });
        };

        const paint = (event) => {
          for (const point of points) {
            const distance = Math.hypot(event.clientX - point.x, event.clientY - point.y);
            const strength = Math.max(0, 1 - distance / 125);

            if (strength > 0.58) {
              point.cell.style.color = "var(--orange)";
              point.cell.style.filter = "drop-shadow(0 0 7px rgba(255, 122, 26, 0.35))";
            } else if (strength > 0.16) {
              point.cell.style.color = "rgba(236, 232, 223, 0.86)";
              point.cell.style.filter = "none";
            } else {
              point.cell.style.color = "";
              point.cell.style.filter = "";
            }
          }
        };

        stage.addEventListener("pointerenter", measure);
        stage.addEventListener("pointermove", (event) => {
          if (event.pointerType === "touch") return;
          if (!points.length) measure();
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => paint(event));
        });

        stage.addEventListener("pointerleave", () => {
          cancelAnimationFrame(frame);
          for (const point of points) {
            point.cell.style.color = "";
            point.cell.style.filter = "";
          }
        });

        window.addEventListener("resize", measure, { passive: true });
      }

      document.querySelectorAll(".v-hover").forEach(setupHover);

      function setupDither(canvas) {
        const stage = canvas.parentElement;
        const word = canvas.dataset.word || "ASCII-THINGS";
        const mode = canvas.dataset.mode || "wordmark";
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
        const ctx = canvas.getContext("2d");
        const mono =
          getComputedStyle(document.documentElement).getPropertyValue("--mono").trim() ||
          "ui-monospace, monospace";
        const bayer = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
        let width = 0;
        let height = 0;
        let mask = null;
        let raf = 0;
        let running = false;
        let visible = true;
        let last = 0;

        function buildMask() {
          const off = document.createElement("canvas");
          off.width = width;
          off.height = height;
          const offCtx = off.getContext("2d");

          offCtx.fillStyle = "#000";
          offCtx.fillRect(0, 0, width, height);
          offCtx.fillStyle = "#fff";

          let size = height * 0.82;
          offCtx.font = `700 ${size}px ${mono}`;
          const maxWidth = width * 0.84;

          while (offCtx.measureText(word).width > maxWidth && size > 8) {
            size *= 0.92;
            offCtx.font = `700 ${size}px ${mono}`;
          }

          offCtx.textAlign = "center";
          offCtx.textBaseline = "middle";
          offCtx.fillText(word, width / 2, height / 2);
          mask = offCtx.getImageData(0, 0, width, height).data;
        }

        function brightness(x, y) {
          const px = Math.max(0, Math.min(width - 1, Math.floor(x)));
          const py = Math.max(0, Math.min(height - 1, Math.floor(y)));
          return mask[(py * width + px) * 4] / 255;
        }

        function draw(time) {
          ctx.clearRect(0, 0, width, height);

          if (mode === "field") drawField(time);
          else drawWordmark(time);
        }

        function drawWordmark(time) {
          const step = Math.max(1.7, width / 330);
          const scanX = time === 0 ? width * 0.18 : ((time * 0.06) % (width + 240)) - 120;

          for (let y = 0; y < height; y += step) {
            for (let x = 0; x < width; x += step) {
              const value = brightness(x + step / 2, y + step / 2);
              if (value < 0.12) continue;

              const bx = Math.floor(x / step) % 4;
              const by = Math.floor(y / step) % 4;
              const threshold = 0.42 + 0.08 * Math.sin(time * 0.0012 + x * 0.01);
              const pattern = bayer[by * 4 + bx] / 16;
              const dither =
                value * 1.1 +
                pattern * 0.38 +
                0.06 * Math.sin(time * 0.002 + x * 0.06 + y * 0.09);

              if (dither < threshold) continue;

              const nearScan = Math.abs(x + step / 2 - scanX) < 44;
              const size = step * (nearScan ? 0.95 : 0.72);

              ctx.fillStyle = nearScan ? "#ff7a1a" : "rgba(236, 232, 223, 0.62)";
              ctx.fillRect(x + (step - size) / 2, y + (step - size) / 2, size, size);
            }
          }
        }

        function drawField(time) {
          const step = Math.max(2.2, width / 240);
          const scanX = time === 0 ? width * 0.18 : ((time * 0.055) % (width + 260)) - 130;

          for (let y = 0; y < height; y += step) {
            for (let x = 0; x < width; x += step) {
              const bx = Math.floor(x / step) % 4;
              const by = Math.floor(y / step) % 4;
              const pattern = bayer[by * 4 + bx] / 16;
              const value = brightness(x + step / 2, y + step / 2);
              const isWord = value > 0.42;
              const wave =
                0.5 + 0.5 * Math.sin(x * 0.012 + y * 0.009 + time * 0.0007);
              const fieldDensity = 0.08 + 0.15 * wave;
              const density = isWord ? 0.78 : fieldDensity;

              if (pattern > density) continue;

              const nearScan = Math.abs(x + step / 2 - scanX) < 58;
              const dot = step * (isWord ? (nearScan ? 0.92 : 0.62) : nearScan ? 0.58 : 0.34);

              ctx.fillStyle = nearScan
                ? "rgba(255, 122, 26, 0.9)"
                : isWord
                  ? "rgba(236, 232, 223, 0.7)"
                  : "rgba(236, 232, 223, 0.2)";
              ctx.fillRect(x + (step - dot) / 2, y + (step - dot) / 2, dot, dot);
            }
          }
        }

        function loop(now) {
          if (!running) return;
          if (now - last > 1000 / 30) {
            draw(now);
            last = now;
          }
          raf = requestAnimationFrame(loop);
        }

        function start() {
          if (reduced.matches || running) return;
          running = true;
          last = 0;
          raf = requestAnimationFrame(loop);
        }

        function stop() {
          running = false;
          cancelAnimationFrame(raf);
          draw(0);
        }

        function resize() {
          const rect = stage.getBoundingClientRect();
          width = Math.max(1, Math.round(rect.width));
          height = Math.max(1, Math.round(rect.height));
          const dpr = Math.min(2, window.devicePixelRatio || 1);

          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          buildMask();
          if (!running) draw(0);
        }

        resize();

        if (reduced.matches) {
          draw(0);
          return;
        }

        const observer = new IntersectionObserver(
          ([entry]) => {
            visible = entry?.isIntersecting ?? true;
            if (visible) start();
            else stop();
          },
          { rootMargin: "180px 0px" },
        );
        observer.observe(stage);

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) stop();
          else if (visible) start();
        });

        reduced.addEventListener("change", () => {
          if (reduced.matches) stop();
          else if (visible) start();
        });

        if ("ResizeObserver" in window) {
          new ResizeObserver(resize).observe(stage);
        } else {
          window.addEventListener("resize", resize, { passive: true });
        }

        document.fonts?.ready.then(resize);
        if (visible) start();
      }

      const previewFrame = document.querySelector(".preview-frame");
      const previewMedia = document.querySelector("[data-preview-media]");
      const previewIndex = document.querySelector("[data-preview-index]");
      const previewName = document.querySelector("[data-preview-name]");
      const previewSection = document.querySelector("[data-preview]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const pickers = [...document.querySelectorAll("[data-select]")];
      const STORAGE_KEY = "ascii-footer-treatment";

      function readInitialTreatment() {
        const hash = location.hash.slice(1);
        if (pickers.some((item) => item.dataset.select === hash)) return hash;
        try {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (stored && pickers.some((item) => item.dataset.select === stored)) return stored;
        } catch {
          // ignore storage errors
        }
        return "field";
      }

      function selectTreatment(id, options = {}) {
        const button = pickers.find((item) => item.dataset.select === id) || pickers[0];
        const nextId = button.dataset.select;

        pickers.forEach((item) => {
          const on = item.dataset.select === nextId;
          item.classList.toggle("is-selected", on);
          item.setAttribute("aria-pressed", String(on));
          item.tabIndex = on ? 0 : -1;
        });

        previewIndex.textContent = button.dataset.index;
        previewName.textContent = button.dataset.name;
        previewFrame.classList.toggle("is-field", nextId === "field");
        previewMedia.innerHTML = "";

        if (nextId === "original") {
          const stage = document.createElement("div");
          stage.className = "stage stage--original";
          const art = document.createElement("div");
          art.className = "art v-original";
          art.dataset.word = "ASCII-THINGS";
          art.dataset.original = "true";
          stage.appendChild(art);
          previewMedia.appendChild(stage);
          renderOriginalArt(art);
        } else if (nextId === "stack") {
          const stage = document.createElement("div");
          stage.className = "stage stage--stack";
          for (const word of ["ASCII", "THINGS"]) {
            const art = document.createElement("div");
            art.className = "art v-stack";
            art.dataset.word = word;
            if (word === "THINGS") art.dataset.rowOffset = "5";
            stage.appendChild(art);
            renderArt(art);
          }
          previewMedia.appendChild(stage);
        } else if (nextId === "dither" || nextId === "field") {
          const stage = document.createElement("div");
          stage.className = nextId === "field" ? "stage stage--field" : "stage stage--dither";
          const canvas = document.createElement("canvas");
          canvas.className = "dither-canvas" + (nextId === "field" ? " field-canvas" : "");
          canvas.dataset.word = "ASCII-THINGS";
          if (nextId === "field") canvas.dataset.mode = "field";
          stage.appendChild(canvas);
          if (nextId !== "field") {
            const hint = document.createElement("span");
            hint.className = "hint";
            hint.textContent = "bayer 4×4 →";
            stage.appendChild(hint);
          }
          previewMedia.appendChild(stage);
          setupDither(canvas);
        } else {
          const stage = document.createElement("div");
          stage.className = "stage";
          const art = document.createElement("div");
          art.className = `art v-${nextId}`;
          art.dataset.word = "ASCII-THINGS";
          stage.appendChild(art);
          previewMedia.appendChild(stage);
          renderArt(art);
          if (nextId === "hover") setupHover(art);
        }

        if (options.persist !== false) {
          try {
            localStorage.setItem(STORAGE_KEY, nextId);
          } catch {
            // ignore storage errors
          }
          if (location.hash !== `#${nextId}`) history.replaceState(null, "", `#${nextId}`);
        }
        if (options.focus) button.focus({ preventScroll: true });

        if (options.scroll) {
          previewSection.scrollIntoView({
            behavior: reducedMotion.matches ? "auto" : "smooth",
            block: "start",
          });
        }
      }

      function movePick(event, item) {
        const index = pickers.indexOf(item);
        let next = index;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % pickers.length;
        else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + pickers.length) % pickers.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = pickers.length - 1;
        else return;
        event.preventDefault();
        const target = pickers[next];
        selectTreatment(target.dataset.select, { persist: true, focus: true });
      }

      pickers.forEach((item) => {
        item.addEventListener("click", () => selectTreatment(item.dataset.select, { persist: true }));
        item.addEventListener("keydown", (event) => movePick(event, item));
      });

      window.addEventListener("hashchange", () => {
        const hash = location.hash.slice(1);
        if (pickers.some((item) => item.dataset.select === hash)) {
          selectTreatment(hash, { persist: false });
        }
      });

      selectTreatment(readInitialTreatment(), { persist: false });

      const BRAND_KEY = "ascii-brand-card";
      const brandPicks = [...document.querySelectorAll(".brand-pick")];
      const brandCards = [...document.querySelectorAll(".brand-card")];
      const brandStatus = document.querySelector("[data-brand-status]");

      function readInitialBrand() {
        try {
          const stored = localStorage.getItem(BRAND_KEY);
          if (stored && brandPicks.some((item) => item.dataset.brand === stored)) return stored;
        } catch {
          // ignore storage errors
        }
        return "apple";
      }

      function selectBrand(id, options = {}) {
        const button = brandPicks.find((item) => item.dataset.brand === id) || brandPicks[0];
        const nextId = button.dataset.brand;

        brandPicks.forEach((item) => {
          const on = item.dataset.brand === nextId;
          item.classList.toggle("is-selected", on);
          item.setAttribute("aria-pressed", String(on));
          item.tabIndex = on ? 0 : -1;
        });

        brandCards.forEach((card) => {
          const on = card.dataset.brand === nextId;
          card.classList.toggle("is-selected", on);
          card.setAttribute("aria-current", String(on));
        });

        if (brandStatus) brandStatus.textContent = `Selected: ${button.dataset.name}`;

        if (options.persist !== false) {
          try {
            localStorage.setItem(BRAND_KEY, nextId);
          } catch {
            // ignore storage errors
          }
        }

        if (options.focus) button.focus({ preventScroll: true });
      }

      function moveBrand(event, item) {
        const index = brandPicks.indexOf(item);
        let next = index;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          next = (index + 1) % brandPicks.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          next = (index - 1 + brandPicks.length) % brandPicks.length;
        } else if (event.key === "Home") {
          next = 0;
        } else if (event.key === "End") {
          next = brandPicks.length - 1;
        } else {
          return;
        }
        event.preventDefault();
        selectBrand(brandPicks[next].dataset.brand, { focus: true });
      }

      brandPicks.forEach((item) => {
        item.addEventListener("click", () => selectBrand(item.dataset.brand));
        item.addEventListener("keydown", (event) => moveBrand(event, item));
      });

      brandCards.forEach((card) => {
        card.addEventListener("click", () => selectBrand(card.dataset.brand));
        card.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            selectBrand(card.dataset.brand);
          }
        });
      });

      selectBrand(readInitialBrand(), { persist: false });

      class LineCard {
        constructor(card, canvas) {
          this.card = card;
          this.canvas = canvas;
          this.ctx = canvas.getContext("2d");
          this.label = canvas.dataset.label || "";
          this.mono =
            getComputedStyle(document.documentElement).getPropertyValue("--mono").trim() ||
            "ui-monospace, monospace";
          this.motion = window.matchMedia("(prefers-reduced-motion: reduce)");
          this.reduced = this.motion.matches;
          this.width = 1;
          this.height = 1;
          this.mask = new Uint8ClampedArray(4);
          this.points = [];
          this.pointer = { x: -1e4, y: -1e4 };
          this.hover = false;
          this.raf = 0;

          this.resize();

          this.card.addEventListener("pointerenter", () => {
            if (this.reduced) return;
            this.hover = true;
            this.start();
          });

          this.card.addEventListener("pointermove", (event) => {
            const rect = this.card.getBoundingClientRect();
            this.pointer.x = event.clientX - rect.left;
            this.pointer.y = event.clientY - rect.top;
            if (!this.reduced && !this.hover) {
              this.hover = true;
              this.start();
            }
          });

          this.card.addEventListener("pointerleave", () => {
            this.hover = false;
            this.stop();
            this.draw(0, false);
          });

          this.card.addEventListener("focus", () => {
            if (this.reduced) return;
            this.hover = true;
            this.start();
          });

          this.card.addEventListener("blur", () => {
            this.hover = false;
            this.stop();
            this.draw(0, false);
          });

          this.motion.addEventListener("change", () => {
            this.reduced = this.motion.matches;
            if (this.reduced) {
              this.hover = false;
              this.stop();
              this.draw(0, false);
            } else if (this.card.matches(":hover")) {
              this.hover = true;
              this.start();
            }
          });

          if ("ResizeObserver" in window) {
            new ResizeObserver(() => this.resize()).observe(this.card);
          } else {
            window.addEventListener("resize", () => this.resize(), { passive: true });
          }

          document.fonts?.ready.then(() => this.resize());
        }

        resize() {
          const rect = this.card.getBoundingClientRect();
          this.width = Math.max(1, Math.round(rect.width));
          this.height = Math.max(1, Math.round(rect.height));
          const dpr = Math.min(window.devicePixelRatio || 1, 2);

          this.canvas.width = Math.round(this.width * dpr);
          this.canvas.height = Math.round(this.height * dpr);
          this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          this.buildMask();
          this.points = this.brightPoints();
          if (!this.hover) this.draw(0, false);
        }

        buildMask() {
          const off = document.createElement("canvas");
          off.width = this.width;
          off.height = this.height;
          const c = off.getContext("2d");

          c.fillStyle = "#000";
          c.fillRect(0, 0, this.width, this.height);
          c.fillStyle = "#fff";

          let size = this.height * 0.68;
          c.font = `700 ${size}px ${this.mono}`;
          while (c.measureText(this.label).width > this.width * 0.8 && size > 7) {
            size *= 0.92;
            c.font = `700 ${size}px ${this.mono}`;
          }

          c.textAlign = "center";
          c.textBaseline = "middle";
          c.fillText(this.label, this.width / 2, this.height * 0.42);
          this.mask = c.getImageData(0, 0, this.width, this.height).data;
        }

        brightness(x, y) {
          const xi = Math.max(0, Math.min(this.width - 1, Math.round(x)));
          const yi = Math.max(0, Math.min(this.height - 1, Math.round(y)));
          return this.mask[(yi * this.width + xi) * 4] / 255;
        }

        brightPoints() {
          const found = [];
          const step = Math.max(5, Math.round(this.width / 26));

          for (let y = step; y < this.height - step; y += step) {
            for (let x = step; x < this.width - step; x += step) {
              const value = this.brightness(x, y);
              if (value > 0.8) found.push({ x, y, value });
            }
          }

          found.sort((a, b) => b.value - a.value);
          const out = [];
          for (const point of found) {
            if (out.every((other) => Math.hypot(other.x - point.x, other.y - point.y) > this.width * 0.28)) {
              out.push(point);
            }
            if (out.length >= 3) break;
          }
          return out;
        }

        draw(time, hover) {
          const { width: w, height: h, ctx } = this;
          ctx.clearRect(0, 0, w, h);

          ctx.fillStyle = "rgba(236,232,223,.035)";
          for (let x = 0; x < w; x += Math.max(6, w / 80)) {
            ctx.fillRect(x, 0, 0.5, h);
          }

          const gap = Math.max(3.4, w / 92);
          const step = Math.max(2.2, h / 58);
          const scanX = hover ? ((time * 0.045) % (w + 180)) - 90 : -1e4;

          for (let x = 0; x < w; x += gap) {
            const distance = hover ? Math.abs(x - this.pointer.x) : 1e4;
            const push =
              hover && distance < 80
                ? (1 - distance / 80) * 13 * Math.sin(time * 0.007 + x * 0.02)
                : 0;
            const drawX = x + push;

            for (let y = 0; y < h; y += step) {
              let value = this.brightness(x, y);
              if (hover) value += Math.sin(time * 0.003 + x * 0.05 + y * 0.08) * 0.08;
              if (value <= 0.08) continue;

              const lineWidth =
                value > 0.82 ? 2.4 : value > 0.58 ? 1.7 : value > 0.34 ? 1.1 : 0.65;
              const nearScan = hover && Math.abs(drawX - scanX) < 30;
              ctx.fillStyle = nearScan ? "rgba(255,122,26,.92)" : "rgba(236,232,223,.4)";
              ctx.fillRect(drawX, y, lineWidth, step);
            }
          }

          if (hover && this.points.length) {
            ctx.strokeStyle = "rgba(255,122,26,.85)";
            ctx.fillStyle = "rgba(255,122,26,.95)";
            ctx.lineWidth = 1;
            ctx.font = "8px ui-monospace, monospace";
            ctx.textBaseline = "alphabetic";

            this.points.forEach((point, index) => {
              const size = 20;
              ctx.strokeRect(point.x - size / 2, point.y - size / 2, size, size);
              ctx.fillText(
                `${Math.round(point.x)},${Math.round(point.y)}`,
                point.x - size / 2,
                point.y - size / 2 - 4,
              );

              if (index > 0) {
                const previous = this.points[index - 1];
                ctx.beginPath();
                ctx.moveTo(previous.x, previous.y);
                ctx.lineTo(point.x, point.y);
                ctx.stroke();
              }
            });
          }
        }

        start() {
          if (this.reduced || this.raf) return;
          const tick = (now) => {
            this.raf = 0;
            if (!this.hover) return;
            this.draw(now, true);
            this.raf = requestAnimationFrame(tick);
          };
          this.raf = requestAnimationFrame(tick);
        }

        stop() {
          if (this.raf) cancelAnimationFrame(this.raf);
          this.raf = 0;
        }
      }

      document.querySelectorAll(".link-card").forEach((card) => {
        const canvas = card.querySelector(".link-canvas");
        if (canvas) new LineCard(card, canvas);
      });

      document.querySelectorAll(".dither-canvas").forEach(setupDither);
    </script>
  </body>
</html>
