---
const variants = [
  {
    id: "original",
    index: "00",
    title: "Original block wordmark",
    tone: "exact",
    desc: "The exact first version: literal █ characters, a 7.5s row-major scan, and one orange origin cell.",
    original: true,
  },
  {
    id: "scan",
    index: "01",
    title: "Horizontal scan",
    tone: "baseline",
    desc: "The original row-major pulse. A soft orange band travels across the wordmark and repeats.",
  },
  {
    id: "column",
    index: "02",
    title: "Column sweep",
    tone: "motion",
    desc: "A vertical band moves left to right. Calmer, more like a scanner passing over the letters.",
  },
  {
    id: "cascade",
    index: "03",
    title: "Letter cascade",
    tone: "motion",
    desc: "Each letter flashes as a whole, then hands off to the next. Reads as a terminal decoding a word.",
  },
  {
    id: "decode",
    index: "04",
    title: "Terminal decode",
    tone: "motion",
    desc: "Sparse cells flicker in a deterministic noise pattern. More texture, less predictable.",
  },
  {
    id: "hover",
    index: "05",
    title: "Hover field",
    tone: "interactive",
    desc: "No idle motion. Moving across the wordmark lights nearby cells and leaves a fading trail.",
  },
  {
    id: "dots",
    index: "06",
    title: "Dot matrix",
    tone: "form",
    desc: "The same glyphs with smaller square cells and more air. Refined, but still clearly ASCII.",
    dots: true,
  },
  {
    id: "stack",
    index: "07",
    title: "Stacked lockup",
    tone: "form",
    desc: "ASCII over THINGS. A row refresh travels through both lines; the mark gets more vertical space.",
  },
  {
    id: "reverse",
    index: "08",
    title: "Reverse tone",
    tone: "color",
    desc: "Orange blocks with an ivory scan. Stronger brand color, but louder in the footer.",
  },
  {
    id: "dither",
    index: "09",
    title: "Ordered dither",
    tone: "texture",
    desc: "A 4×4 Bayer field redraws the wordmark as a moving dot grid. Canvas dither, not block cells.",
  },
  {
    id: "field",
    index: "10",
    title: "Dither field",
    tone: "texture",
    desc: "The whole footer band becomes a 4×4 Bayer field. The wordmark emerges as a denser region while a slow orange scan crosses the surface.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Footer wordmark lab — ascii-things</title>
    <meta name="robots" content="noindex" />
    <style is:inline>
      :root {
        color-scheme: dark;
        --bg: #070809;
        --panel: #0b0d0f;
        --line: #24262a;
        --ink: #ece8df;
        --muted: #8d8a82;
        --dim: rgba(236, 232, 223, 0.2);
        --orange: #ff7a1a;
        --mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at 16% 0%, rgba(255, 122, 26, 0.06), transparent 32rem),
          var(--bg);
        color: var(--ink);
        font-family: var(--mono);
        min-height: 100vh;
      }

      .shell {
        width: min(1180px, calc(100vw - 64px));
        margin: 0 auto;
        padding: 48px 0 72px;
      }

      .lab-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 32px;
        padding-bottom: 28px;
        border-bottom: 1px solid var(--line);
      }

      .eyebrow {
        margin: 0 0 14px;
        color: var(--orange);
        font-size: 9px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(28px, 4.5vw, 54px);
        font-weight: 600;
        letter-spacing: -0.055em;
        line-height: 0.95;
      }

      .intro {
        max-width: 580px;
        margin: 18px 0 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.75;
      }

      .lab-note {
        max-width: 240px;
        margin: 0;
        padding-left: 18px;
        border-left: 1px solid var(--line);
        color: var(--muted);
        font-size: 9px;
        line-height: 1.7;
      }

      .lab-note b {
        color: var(--ink);
        font-weight: 500;
      }

      .preview {
        margin-top: 28px;
        padding: 20px;
        border: 1px solid var(--line);
        background: var(--panel);
      }

      .preview-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 16px;
      }

      .preview-head h2 {
        margin: 4px 0 0;
        font-size: 18px;
        letter-spacing: -0.03em;
      }

      .picker {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .pick {
        appearance: none;
        min-width: 32px;
        height: 28px;
        padding: 0 8px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 9px;
        letter-spacing: 0.08em;
        cursor: pointer;
      }

      .pick:hover {
        color: var(--ink);
        border-color: #4a4a4a;
      }

      .pick.is-selected {
        color: var(--orange);
        border-color: var(--orange);
        background: rgba(255, 122, 26, 0.08);
      }

      .pick:focus-visible {
        outline: 1px solid var(--orange);
        outline-offset: 2px;
      }

      .preview-frame {
        position: relative;
        border: 1px solid var(--line);
        background: #050607;
        overflow: hidden;
      }

      .preview-media {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 170px;
        padding: 24px;
        border-bottom: 1px solid var(--line);
      }

      .preview-media .art {
        font-size: clamp(6px, 1.5vw, 24px);
      }

      .preview-media .v-stack {
        font-size: clamp(9px, 2.2vw, 34px);
      }

      .preview-media .dither-canvas {
        height: 150px;
      }

      .preview-frame.is-field {
        min-height: 340px;
      }

      .preview-frame.is-field .preview-media {
        position: absolute;
        inset: 0;
        z-index: 0;
        padding: 0;
        min-height: 0;
        border: 0;
      }

      .preview-frame.is-field .preview-media .field-canvas {
        height: 100%;
      }

      .preview-frame.is-field .preview-media .stage--field {
        width: 100%;
        height: 100%;
        min-height: 0;
      }

      .preview-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 20px;
      }

      .preview-frame.is-field .preview-content {
        text-shadow: 0 1px 12px rgba(5, 6, 7, 0.95);
      }

      .preview-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
      }

      .preview-brand {
        font-size: 12px;
        font-weight: 600;
      }

      .preview-brand span {
        color: var(--orange);
        font-size: 7px;
        vertical-align: super;
      }

      .preview-credit {
        max-width: 460px;
        color: var(--muted);
        font-size: 9px;
        line-height: 1.6;
        text-align: right;
      }

      .preview-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        color: var(--muted);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .preview-links .preview-live {
        margin-left: auto;
        color: var(--orange);
      }

      .preview-note {
        margin: 14px 0 0;
        color: var(--muted);
        font-size: 9px;
        line-height: 1.6;
      }

      @media (max-width: 720px) {
        .preview-head {
          display: block;
        }

        .picker {
          margin-top: 14px;
        }

        .preview-top {
          display: block;
        }

        .preview-credit {
          display: block;
          margin-top: 8px;
          text-align: left;
        }

        .preview-frame.is-field {
          min-height: 300px;
        }
      }

      .brand-lab {
        margin-top: 46px;
        padding-top: 30px;
        border-top: 1px solid var(--line);
      }

      .brand-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
      }

      .brand-card {
        min-height: 300px;
        cursor: pointer;
      }

      .brand-card.is-selected {
        border-color: var(--orange);
        box-shadow: inset 0 0 0 1px rgba(255, 122, 26, 0.45);
      }

      .brand-card.is-selected .link-kicker {
        color: var(--ink);
      }

      .brand-card .link-copy {
        inset: auto 16px 16px;
      }

      .brand-card .link-title {
        font-size: 20px;
      }

      .brand-head-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
      }

      .brand-picker {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .brand-pick {
        appearance: none;
        min-width: 32px;
        height: 28px;
        padding: 0 8px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 9px;
        letter-spacing: 0.08em;
        cursor: pointer;
      }

      .brand-pick:hover {
        color: var(--ink);
        border-color: #4a4a4a;
      }

      .brand-pick.is-selected {
        color: var(--orange);
        border-color: var(--orange);
        background: rgba(255, 122, 26, 0.08);
      }

      .brand-pick:focus-visible {
        outline: 1px solid var(--orange);
        outline-offset: 2px;
      }

      .brand-status {
        margin: 0;
        color: var(--muted);
        font-size: 9px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      @media (max-width: 720px) {
        .brand-head-actions {
          align-items: flex-start;
        }
      }

      @media (max-width: 980px) {
        .brand-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 560px) {
        .brand-grid {
          grid-template-columns: 1fr;
        }

        .brand-card {
          min-height: 240px;
        }
      }

      .link-lab {
        margin-top: 46px;
        padding-top: 30px;
        border-top: 1px solid var(--line);
      }

      .link-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 18px;
      }

      .link-head h2 {
        margin: 4px 0 0;
        font-size: 24px;
        letter-spacing: -0.04em;
      }

      .link-note {
        max-width: 340px;
        margin: 0;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.65;
        text-align: right;
      }

      .link-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
      }

      .link-card {
        position: relative;
        display: block;
        min-height: 196px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: #050607;
        color: var(--ink);
        text-decoration: none;
      }

      .link-canvas {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      .link-shade {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(
          180deg,
          rgba(5, 6, 7, 0) 18%,
          rgba(5, 6, 7, 0.5) 58%,
          rgba(5, 6, 7, 0.97) 100%
        );
      }

      .link-copy {
        position: absolute;
        inset: auto 14px 14px;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .link-kicker {
        color: var(--orange);
        font-size: 8px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .link-title {
        font-size: 17px;
        font-weight: 600;
        letter-spacing: -0.03em;
      }

      .link-desc {
        color: var(--muted);
        font-size: 9px;
        line-height: 1.5;
      }

      .link-open {
        margin-top: 6px;
        color: var(--ink);
        font-size: 8px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .link-card:hover {
        border-color: rgba(255, 122, 26, 0.55);
      }

      .link-card:focus-visible {
        outline: 1px solid var(--orange);
        outline-offset: 3px;
      }

      @media (max-width: 980px) {
        .link-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 560px) {
        .link-head {
          display: block;
        }

        .link-note {
          margin-top: 10px;
          text-align: left;
        }

        .link-grid {
          grid-template-columns: 1fr;
        }

        .link-card {
          min-height: 170px;
        }
      }

      .grid {
        display: grid;
        gap: 0;
        margin-top: 18px;
      }

      .card {
        display: grid;
        grid-template-columns: 238px minmax(0, 1fr);
        gap: 34px;
        align-items: center;
        padding: 24px 0;
        border-bottom: 1px solid var(--line);
      }

      .card:first-child {
        border-top: 1px solid var(--line);
      }

      .card--wide {
        grid-template-columns: 1fr;
        gap: 18px;
        padding: 28px 0;
      }

      .card--wide .card-copy {
        max-width: 640px;
      }

      .card-copy {
        min-width: 0;
      }

      .index {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        color: var(--orange);
        font-size: 9px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .tone {
        color: #6d6a63;
        font-size: 8px;
        letter-spacing: 0.12em;
      }

      h2 {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: -0.025em;
      }

      .desc {
        margin: 0;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.65;
      }

      .stage {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        min-height: 104px;
        overflow: hidden;
      }

      .stage::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent, rgba(236, 232, 223, 0.025), transparent);
        pointer-events: none;
      }

      .stage--stack {
        flex-direction: column;
        gap: 2px;
        min-height: 154px;
      }

      .stage--dither {
        min-height: 104px;
      }

      .dither-canvas {
        display: block;
        width: 100%;
        height: 104px;
      }

      .stage--field {
        min-height: 220px;
        background: radial-gradient(ellipse at 50% 50%, rgba(255, 122, 26, 0.035), transparent 68%);
      }

      .field-canvas {
        height: 220px;
      }

      .hint {
        position: absolute;
        right: 0;
        bottom: 0;
        color: #65625b;
        font-size: 8px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        pointer-events: none;
      }

      .art {
        display: block;
        flex: 0 0 auto;
        width: max-content;
        max-width: 100%;
        color: var(--dim);
        font-family: var(--mono);
        line-height: 0;
        user-select: none;
        -webkit-user-select: none;
      }

      .v-scan,
      .v-column,
      .v-cascade,
      .v-decode,
      .v-dots,
      .v-reverse {
        font-size: clamp(4.4px, 1.35vw, 22px);
      }

      .v-stack {
        font-size: clamp(7px, 2.2vw, 34px);
      }

      .v-hover {
        font-size: clamp(4.4px, 1.35vw, 22px);
      }

      .v-original {
        color: rgba(236, 232, 223, 0.2);
        font-size: clamp(5.9px, 1.35vw, 20px);
        font-weight: 700;
        line-height: 0.86;
        filter: drop-shadow(0 0 24px rgba(255, 122, 26, 0.08));
      }

      .orig-line {
        display: block;
        white-space: pre;
      }

      .orig-cell {
        color: inherit;
        animation: origScan 7.5s linear infinite;
        animation-delay: calc(var(--i) * -0.052s);
      }

      .orig-cell.orig-origin {
        color: var(--orange);
      }

      @keyframes origScan {
        0%,
        93%,
        100% {
          color: rgba(236, 232, 223, 0.2);
        }
        94%,
        96% {
          color: var(--orange);
        }
      }

      .art-line {
        display: flex;
        height: 0.62em;
      }

      .cell {
        display: block;
        flex: 0 0 auto;
        width: 0.62em;
        height: 0.62em;
        color: inherit;
      }

      .cell i {
        display: block;
        width: 100%;
        height: 100%;
        background: currentColor;
      }

      .art--dots {
        --dim: rgba(236, 232, 223, 0.32);
      }

      .art--dots .cell i {
        transform: scale(0.62);
        transform-origin: center;
      }

      .cell.origin {
        color: var(--orange);
      }

      .v-scan .cell.on {
        animation: scanPulse 7.5s linear infinite;
        animation-delay: calc(var(--i) * -0.052s);
      }

      .v-column .cell.on {
        animation: columnPulse 5s linear infinite;
        animation-delay: calc(var(--col) * -0.06s);
      }

      .v-cascade .cell.on {
        animation: letterPulse 5.2s linear infinite;
        animation-delay: calc(var(--letter) * -0.36s);
      }

      .v-decode .cell.on {
        animation: decodePulse 3.2s steps(1, end) infinite;
        animation-delay: calc(var(--rand) * -3.2s);
      }

      .v-dots .cell.on {
        animation: scanPulse 8.5s linear infinite;
        animation-delay: calc(var(--i) * -0.06s);
      }

      .v-stack .cell.on {
        animation: rowPulse 3.6s linear infinite;
        animation-delay: calc(var(--row) * -0.55s);
      }

      .v-reverse .cell.on {
        color: var(--orange);
        animation: reversePulse 7.5s linear infinite;
        animation-delay: calc(var(--i) * -0.052s);
      }

      .v-hover .cell.on {
        transition: color 180ms ease, filter 180ms ease;
      }

      .v-hover .stage {
        cursor: crosshair;
      }

      @keyframes scanPulse {
        0%,
        93%,
        100% {
          color: var(--dim);
        }
        94%,
        96% {
          color: var(--orange);
        }
      }

      @keyframes columnPulse {
        0%,
        92%,
        100% {
          color: var(--dim);
        }
        94%,
        96% {
          color: var(--orange);
        }
      }

      @keyframes letterPulse {
        0%,
        88%,
        100% {
          color: var(--dim);
        }
        91%,
        94% {
          color: var(--orange);
        }
      }

      @keyframes decodePulse {
        0%,
        86%,
        100% {
          color: var(--dim);
        }
        88%,
        91% {
          color: var(--orange);
        }
        94% {
          color: var(--ink);
        }
      }

      @keyframes rowPulse {
        0%,
        86%,
        100% {
          color: var(--dim);
        }
        89%,
        93% {
          color: var(--orange);
        }
      }

      @keyframes reversePulse {
        0%,
        91%,
        100% {
          color: var(--orange);
        }
        93%,
        96% {
          color: var(--ink);
        }
      }

      .lab-foot {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 32px;
        padding-top: 28px;
        color: var(--muted);
        font-size: 9px;
        line-height: 1.7;
      }

      .lab-foot b {
        color: var(--ink);
        font-weight: 500;
      }

      .back {
        color: var(--orange);
        text-decoration: none;
        white-space: nowrap;
      }

      .back:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      @media (max-width: 760px) {
        .shell {
          width: calc(100vw - 32px);
          padding: 30px 0 52px;
        }

        .lab-head {
          display: block;
        }

        .lab-note {
          max-width: none;
          margin-top: 20px;
          padding-left: 0;
          border-left: 0;
          border-top: 1px solid var(--line);
          padding-top: 14px;
        }

        .card {
          grid-template-columns: 1fr;
          gap: 16px;
          padding: 22px 0;
        }

        .stage {
          min-height: 84px;
        }

        .stage--stack {
          min-height: 130px;
        }

        .dither-canvas {
          height: 84px;
        }

        .stage--field {
          min-height: 150px;
        }

        .field-canvas {
          height: 150px;
        }

        .lab-foot {
          display: block;
        }

        .back {
          display: inline-block;
          margin-top: 14px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .cell.on {
          animation: none !important;
          color: var(--dim) !important;
        }

        .v-reverse .cell.on {
          color: var(--dim) !important;
        }

        .orig-cell {
          animation: none !important;
          color: rgba(236, 232, 223, 0.2) !important;
        }

        .orig-cell.orig-origin {
          color: var(--orange) !important;
        }

        .cell.origin,
        .v-reverse .cell.origin {
          color: var(--orange) !important;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="lab-head">
        <div>
          <p class="eyebrow">Throwaway lab / footer treatments</p>
          <h1>Footer treatments</h1>
          <p class="intro">
