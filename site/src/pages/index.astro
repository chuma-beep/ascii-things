---
import "../styles/landing.css";
import KanjiMarks from "../components/KanjiMarks.astro";
import MobileNav from "../components/MobileNav.astro";

const reactSnippet = `<span class="tok-key">import</span> { AsciiDog } <span class="tok-key">from</span> <span class="tok-str">"ascii-things/react"</span>;

<span class="tok-key">export function</span> <span class="tok-fn">Hero</span>() {
  <span class="tok-key">return</span> (
    <span class="tok-tag">&lt;AsciiDog</span>
      <span class="tok-attr">palette</span>=<span class="tok-str">"abyss"</span>
      <span class="tok-attr">seed</span>={7}
      <span class="tok-attr">spread</span>={[0.68, 0.68]}
      <span class="tok-attr">label</span>=<span class="tok-str">"A live ASCII robot dog test yard"</span>
    <span class="tok-tag">/&gt;</span>
  );
}`;

const htmlSnippet = `<span class="tok-tag">&lt;script</span> <span class="tok-attr">type</span>=<span class="tok-str">"module"</span><span class="tok-tag">&gt;</span>
  <span class="tok-key">import</span> <span class="tok-str">"ascii-things/element"</span>;
<span class="tok-tag">&lt;/script&gt;</span>

<span class="tok-tag">&lt;ascii-dog</span>
  <span class="tok-attr">palette</span>=<span class="tok-str">"abyss"</span>
  <span class="tok-attr">seed</span>=<span class="tok-str">"7"</span>
  <span class="tok-attr">spread</span>=<span class="tok-str">"0.68,0.68"</span>
  <span class="tok-attr">style</span>=<span class="tok-str">"height: 420px"</span>
<span class="tok-tag">&gt;&lt;/ascii-dog&gt;</span>`;

const vanillaSnippet = `<span class="tok-key">import</span> { createDog } <span class="tok-key">from</span> <span class="tok-str">"ascii-things/dog"</span>;

<span class="tok-key">const</span> scene = <span class="tok-fn">createDog</span>(canvas, {
  palette: <span class="tok-str">"abyss"</span>,
  seed: <span class="tok-num">7</span>,
  count: <span class="tok-num">1</span>,
  spread: [<span class="tok-num">0.68</span>, <span class="tok-num">0.68</span>],
  interactive: <span class="tok-num">true</span>,
});

scene.<span class="tok-fn">throwBall</span>(canvas.clientWidth * <span class="tok-num">0.55</span>, canvas.clientHeight * <span class="tok-num">0.5</span>);`;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ascii-things — living ASCII scenes for the web</title>
    <meta
      name="description"
      content="Living ASCII scenes you can drop behind any UI: a shark tank, a robot floor, a jellyfish bloom, and a robot dog. Zero dependencies. One canvas. MIT."
    />
    <meta name="theme-color" content="#070809" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/favicon-motion.js" type="module"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content="ascii-things — living ASCII scenes for the web" />
    <meta
      property="og:description"
      content="A shark tank, a robot floor, a jellyfish bloom, and one very good robot dog. Zero dependencies. One canvas."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ascii-things-docs.pages.dev/" />
    <meta property="og:site_name" content="ascii-things" />
    <link rel="canonical" href="https://ascii-things-docs.pages.dev/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="ascii-things — living ASCII scenes for the web" />
    <meta
      name="twitter:description"
      content="A shark tank, a robot floor, a jellyfish bloom, and one very good robot dog. Zero dependencies. One canvas."
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">ascii-things<span>®</span></a>
      <nav class="site-nav" aria-label="Primary">
        <details class="nav-library">
          <summary>Library</summary>
          <div class="nav-library__panel">
            <a href="/library/">All items</a>
            <a href="/showcase/">Showcase</a>
            <a href="/design-ideas/">Design ideas</a>
            <a href="/library/#library-search">Search the library</a>
            <a href="/library/?type=scene">Scenes</a>
            <a href="/library/?type=webgl">WebGL</a>
            <a href="/library/?type=kanji">Kanji</a>
            <a href="/library/?type=component">Components</a>
            <a href="/library/?type=tool">Tools</a>
            <a href="/image/">Image studio</a>
            <a href="/symbols/">ASCII symbols</a>
          </div>
        </details>
        <a href="#scenes">Scenes</a>
        <a href="/webgl/">WebGL</a>
        <a href="/components/">Components</a>
        <a href="/guide/">Docs</a>
        <a href="/api/">API</a>
        <a href="/playground/">Playground ↗</a>
      </nav>
      <div class="header-end">
        <span class="version">v1.0.0-rc.0</span>
        <a class="github" href="https://github.com/chuma-beep/ascii-things">GitHub ↗</a>
      </div>
      <MobileNav />
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-art">
          <canvas id="hero-canvas" aria-hidden="true"></canvas>
        </div>
        <div class="hero-shade"></div>

        <div class="hero-copy">
          <p class="eyebrow"><i class="live-dot"></i> LIVING ASCII SCENES · v1.0.0-rc.0</p>
          <h1 id="hero-title">Your interface,<br /><em>but alive.</em></h1>
          <p class="hero-lede">
            Drop a shark tank, a robot floor, a jellyfish bloom, or one very good robot
            dog behind your UI. Zero dependencies. One canvas.
          </p>

          <div class="install-pill">
            <span class="prompt-caret">$</span>
            <code id="install-command">npm i ascii-things</code>
            <button class="copy-button" type="button" data-copy="npm i ascii-things">copy</button>
          </div>

          <div class="hero-actions">
            <a class="button primary" href="#scenes">Explore the scenes</a>
            <a class="button ghost" href="/guide/installation/">Read the docs ↗</a>
          </div>

          <div class="try-scene">
            <p class="try-label">TRY THE SCENE <span>· click, type, or throw</span></p>
            <form id="prompt" class="prompt">
              <label class="sr-only" for="command">Tell the dog what to fetch</label>
              <span class="prompt-caret">›</span>
              <input
                id="command"
                name="command"
                type="text"
                autocomplete="off"
                maxlength="72"
                placeholder="Tell the dog what to fetch…"
                required
              />
              <button type="submit">THROW ↵</button>
            </form>
            <div class="prompt-meta" aria-live="polite">
              <span id="echo">yard@04 · awaiting command</span>
              <span id="reply">UNIT 01 · IDLE · BALL READY</span>
            </div>
          </div>
        </div>

        <aside class="hero-status" aria-hidden="true">
          <div><span>CELLS</span><strong id="stat-cells">8,640</strong></div>
          <div><span>UNITS</span><strong id="stat-dogs">01</strong></div>
          <div><span>STATE</span><strong id="stat-state">SNIFF</strong></div>
          <div><span>FPS</span><strong id="stat-fps">60</strong></div>
        </aside>

        <a class="scroll-cue" href="#scenes">SCROLL ↓</a>
      </section>

      <section id="scenes" class="section scenes" aria-labelledby="scenes-title">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">01 / HABITATS</p>
            <h2 id="scenes-title">Living scenes.<br />One tiny runtime.</h2>
            <p class="section-lede">
              Each one is a small ecosystem, not a looped animation. Seeded, themeable,
              and capped so it stays fast on a real page.
            </p>
          </div>

          <div class="scene-grid">
            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="sharks" aria-hidden="true"></canvas>
                <span class="scene-index">01</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Shark tank</h3>
                  <a class="scene-open" href="/scenes/sharks/" aria-label="Open shark tank docs"
                    >OPEN ↗</a
                  >
                </div>
                <p>Schools, hunts, panic, and settles. Eight sharks, five fish species.</p>
                <span class="scene-meta">BOIDS · PURSUIT · WAKE</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="robots" aria-hidden="true"></canvas>
                <span class="scene-index">02</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Robot floor</h3>
                  <a
                    class="scene-open"
                    href="/scenes/robots/"
                    aria-label="Open robot floor docs">OPEN ↗</a
                  >
                </div>
                <p>A working factory floor. Patrols, jobs, charging bays, low batteries.</p>
                <span class="scene-meta">STATES · DOCKS · DISPATCH</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="jellyfish" aria-hidden="true"></canvas>
                <span class="scene-index">03</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Jellyfish bloom</h3>
                  <a
                    class="scene-open"
                    href="/scenes/jellyfish/"
                    aria-label="Open jellyfish bloom docs">OPEN ↗</a
                  >
                </div>
                <p>Five kinds of bell, drifting on a live current. Click to send a shockwave.</p>
                <span class="scene-meta">PULSE · CURRENT · GLOW</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="dog" aria-hidden="true"></canvas>
                <span class="scene-index">04</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Robot dog</h3>
                  <a class="scene-open" href="/scenes/dog/" aria-label="Open robot dog docs"
                    >OPEN ↗</a
                  >
                </div>
                <p>A test yard with a ball, a dock, and a very good quadruped.</p>
                <span class="scene-meta">GAIT · FETCH · CHARGE</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="starlings" aria-hidden="true"></canvas>
                <span class="scene-index">05</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Starling murmuration</h3>
                  <a class="scene-open" href="/scenes/starlings/" aria-label="Open starling murmuration docs"
                    >OPEN ↗</a
                  >
                </div>
                <p>A murmuration folds, ripples, and scatters around a hunting shadow.</p>
                <span class="scene-meta">BOIDS · ROOST · SCATTER</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="fireflies" aria-hidden="true"></canvas>
                <span class="scene-index">06</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Firefly meadow</h3>
                  <a class="scene-open" href="/scenes/fireflies/" aria-label="Open firefly meadow docs"
                    >OPEN ↗</a
                  >
                </div>
                <p>A dusk meadow where a few hundred small lights drift and blink.</p>
                <span class="scene-meta">DRIFT · BLINK · FLARE</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="ants" aria-hidden="true"></canvas>
                <span class="scene-index">07</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Ant trail</h3>
                  <a class="scene-open" href="/scenes/ants/" aria-label="Open ant trail docs"
                    >OPEN ↗</a
                  >
                </div>
                <p>A colony lays trails, finds crumbs, and carries food home.</p>
                <span class="scene-meta">TRAILS · FORAGE · NEST</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="koi" aria-hidden="true"></canvas>
                <span class="scene-index">08</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Koi pond</h3>
                  <a class="scene-open" href="/scenes/koi/" aria-label="Open koi pond docs"
                    >OPEN ↗</a
                  >
                </div>
                <p>A pond of koi, lily pads, and ripples that spread from every visit.</p>
                <span class="scene-meta">SCHOOL · RIPPLES · FEED</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="city" aria-hidden="true"></canvas>
                <span class="scene-index">09</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>City grid</h3>
                  <a class="scene-open" href="/scenes/city/" aria-label="Open city grid docs"
                    >OPEN ↗</a
                  >
                </div>
                <p>A night grid of towers, windows, traffic, and signals.</p>
                <span class="scene-meta">GRID · TRAFFIC · NIGHT</span>
              </div>
            </article>

            <article class="scene-card">
              <div class="scene-preview">
                <canvas data-scene="servers" aria-hidden="true"></canvas>
                <span class="scene-index">10</span>
              </div>
              <div class="scene-body">
                <div class="scene-title-row">
                  <h3>Server room</h3>
                  <a class="scene-open" href="/scenes/servers/" aria-label="Open server room docs"
                    >OPEN ↗</a
                  >
                </div>
                <p>A rack room with fans, status LEDs, and packets crossing the aisle.</p>
                <span class="scene-meta">RACKS · PACKETS · PING</span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="kanji" class="section kanji-feature" aria-labelledby="kanji-title">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">02 / KANJI</p>
            <h2 id="kanji-title">The alphabet<br />is the artwork.</h2>
            <p class="section-lede">
              Fifteen studies and two print marks. The same engine, switched to kanji:
              a live helix, fields, water, sky, land, a torii, seasons, a fan, a carved seal,
              and a paper scroll.
            </p>
          </div>
          <KanjiMarks showHelix />
          <div class="kanji-feature__actions">
            <a class="button primary" href="/kanji/">Open the Kanji Lab</a>
            <a class="button ghost" href="/library/?type=kanji">Browse all 17</a>
          </div>
        </div>
      </section>

      <section id="install" class="section install" aria-labelledby="install-title">
        <div class="wrap install-grid">
          <div class="install-copy">
            <p class="eyebrow">03 / INTEGRATE</p>
            <h2 id="install-title">One install.<br />Anywhere you render.</h2>
            <p class="section-lede">
              React, plain HTML, Astro, Vue, Svelte, or a static page. Canvas in, life out.
              The host app keeps its own UI.
            </p>
            <ul class="check-list">
              <li>Zero runtime dependencies</li>
              <li>ESM, tree-shakeable subpath exports</li>
              <li>Optional React ≥ 18 peer</li>
              <li>Works with your design system — or ours</li>
            </ul>
          </div>

          <div class="code-card">
            <div class="code-tabs">
              <div class="code-tablist" role="tablist" aria-label="Integration examples">
                <button
                  type="button"
                  class="code-tab"
                  role="tab"
                  id="tab-react"
                  aria-controls="panel-react"
                  data-tab="react"
                  aria-selected="true">React</button
                >
                <button
                  type="button"
                  class="code-tab"
                  role="tab"
                  id="tab-html"
                  aria-controls="panel-html"
                  data-tab="html"
                  aria-selected="false">Element</button
                >
                <button
                  type="button"
                  class="code-tab"
                  role="tab"
                  id="tab-vanilla"
                  aria-controls="panel-vanilla"
                  data-tab="vanilla"
                  aria-selected="false">Vanilla</button
                >
              </div>
              <button class="code-copy" type="button" data-copy-code>copy</button>
            </div>

            <pre
              class="code-panel"
              id="panel-react"
              role="tabpanel"
              aria-labelledby="tab-react"
              data-panel="react"><code set:html={reactSnippet} /></pre>
            <pre
              class="code-panel"
              id="panel-html"
              role="tabpanel"
              aria-labelledby="tab-html"
              data-panel="html"
              hidden><code set:html={htmlSnippet} /></pre>
            <pre
              class="code-panel"
              id="panel-vanilla"
              role="tabpanel"
              aria-labelledby="tab-vanilla"
              data-panel="vanilla"
              hidden><code set:html={vanillaSnippet} /></pre>
            <p class="code-note">Same API in every scene. Swap the import and the options.</p>
          </div>
        </div>
      </section>

      <section class="section features" aria-labelledby="features-title">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">04 / WHY IT FEELS ALIVE</p>
            <h2 id="features-title">Small simulations.<br />Serious defaults.</h2>
          </div>
          <div class="feature-grid">
            <article class="feature">
              <span class="feature-num">01</span>
              <h3>Zero dependencies</h3>
              <p>One canvas, no WebGL, no image pipeline. The whole runtime is yours to read.</p>
            </article>
            <article class="feature">
              <span class="feature-num">02</span>
              <h3>Deterministic</h3>
              <p>Seed the world and it plays the same way twice. Screenshot it, test it, ship it.</p>
            </article>
            <article class="feature">
              <span class="feature-num">03</span>
              <h3>Themeable</h3>
              <p>Abyss, paper, neon, mono, or a palette of your own. The scene follows your ink.</p>
            </article>
            <article class="feature">
              <span class="feature-num">04</span>
              <h3>Accessible defaults</h3>
              <p>Reduced motion settles the world. Decorative canvases stay out of the a11y tree.</p>
            </article>
            <article class="feature">
              <span class="feature-num">05</span>
              <h3>Built for 60fps</h3>
              <p>Cell caps and adaptive columns keep 4K pages from turning into a particle furnace.</p>
            </article>
            <article class="feature">
              <span class="feature-num">06</span>
              <h3>MIT, forever</h3>
              <p>Use it in a portfolio, a product, or a pitch deck. No seat counts, no watermark.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="manifesto" aria-label="Design principle">
        <div class="wrap">
          <p class="eyebrow">THE PRINCIPLE</p>
          <p class="manifesto-line">Not an animation.<br /><em>A habitat.</em></p>
          <p class="manifesto-sub">
            Every scene runs on its own small rules. No two loads are quite the same.
          </p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <canvas class="footer-canvas" aria-hidden="true"></canvas>
      <div class="footer-content">
        <div class="footer-top">
          <a class="footer-brand" href="#top">ascii-things<span>®</span></a>
          <p class="footer-credit">
            Living ASCII for the web. Built from the original <span class="footer-credit-keep">ascii-sharks.</span>
          </p>
        </div>
        <div class="footer-links">
          <a href="/guide/">Docs ↗</a>
          <a href="https://www.npmjs.com/package/ascii-things">npm ↗</a>
          <a href="https://github.com/chuma-beep/ascii-things">GitHub ↗</a>
          <a href="/playground/">Playground ↗</a>
          <a href="https://github.com/chuma-beep/ascii-things/blob/main/LICENSE">MIT</a>
        </div>
      </div>
    </footer>

    <script>
      import "../scripts/footer-art";
      import "../scripts/landing";
    </script>
  </body>
</html>
