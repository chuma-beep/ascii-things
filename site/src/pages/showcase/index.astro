---
import { LIBRARY } from "../../data/library";
import BackToTop from "../../components/BackToTop.astro";
import ShowcasePreview from "../../components/ShowcasePreview.astro";
import LogoMark from "../../components/LogoMark.astro";
import "../../styles/showcase.css";

type ShowcaseCategory = "scene" | "webgl" | "kanji" | "component";

const CATEGORY_ORDER: ShowcaseCategory[] = ["scene", "webgl", "kanji", "component"];
const CATEGORY_LABEL: Record<ShowcaseCategory, string> = {
  scene: "Scene",
  webgl: "WebGL",
  kanji: "Kanji",
  component: "Component",
};

const pieces = LIBRARY.filter((item) => item.kind !== "tool").map((item) => ({
  ...item,
  category: (item.tags.includes("kanji") ? "kanji" : item.kind) as ShowcaseCategory,
}));

const buckets: Record<ShowcaseCategory, typeof pieces> = {
  scene: [],
  webgl: [],
  kanji: [],
  component: [],
};

for (const piece of pieces) {
  buckets[piece.category].push(piece);
}

const longestBucket = Math.max(...CATEGORY_ORDER.map((key) => buckets[key].length));
const ordered: (typeof pieces)[number][] = [];

for (let index = 0; index < longestBucket; index += 1) {
  for (const key of CATEGORY_ORDER) {
    const piece = buckets[key][index];
    if (piece) ordered.push(piece);
  }
}

const featuredIndex = ordered.findIndex((item) => item.id === "lagoon");
if (featuredIndex > 0) {
  const [featured] = ordered.splice(featuredIndex, 1);
  ordered.unshift(featured);
}

const counts = Object.fromEntries(
  CATEGORY_ORDER.map((key) => [key, buckets[key].length]),
) as Record<ShowcaseCategory, number>;

const filters = [
  { id: "all" as const, label: "All", count: pieces.length },
  ...CATEGORY_ORDER.map((key) => ({
    id: key,
    label: CATEGORY_LABEL[key],
    count: counts[key],
  })),
];

const title = "Showcase — ascii-things";
const description = "The full live archive of scenes, WebGL surfaces, kanji studies, and components.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070809" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/favicon-motion.js" type="module"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="showcase-header">
      <a class="showcase-brand" href="/">
        <LogoMark />
        ascii-things <span>/ showcase</span>
      </a>
      <nav class="showcase-nav" aria-label="Showcase">
        <a href="/library/">Library</a>
        <a href="/design-ideas/">Design ideas</a>
        <a href="/kanji/">Kanji</a>
        <a href="/guide/">Docs</a>
      </nav>
    </header>

    <main class="showcase-main" data-showcase>
      <section class="showcase-hero" aria-labelledby="showcase-title">
        <p class="showcase-eyebrow">Visual archive / {pieces.length} pieces</p>
        <h1 id="showcase-title">All the <em>work.</em></h1>
        <p class="showcase-lede">
          The full live archive of scenes, WebGL surfaces, kanji studies, and components.
          Every card runs the real canvas or component — no archive stills.
        </p>

        <div class="showcase-hero__stage" aria-label="Night reef live preview">
          <div
            class="showcase-hero__frame"
            data-live-tag="ascii-lagoon-night"
            data-live-attrs={JSON.stringify({
              label: "Night reef live ASCII preview",
              interactive: "false",
              "max-dpr": "2",
            })}
            aria-hidden="true"
          ></div>
          <div class="showcase-hero__caption">
            <span>Night reef / live</span>
            <strong>The reef after dark.</strong>
          </div>
        </div>
      </section>

      <div class="showcase-toolbar">
        <div class="showcase-filters" role="group" aria-label="Filter showcase">
          {
            filters.map((filter) => (
              <button
                class:list={["showcase-filter", filter.id === "all" && "is-active"]}
                type="button"
                data-showcase-filter={filter.id}
                aria-pressed={filter.id === "all" ? "true" : "false"}
              >
                {filter.label}
                <span>{filter.count}</span>
              </button>
            ))
          }
        </div>
        <p class="showcase-count" data-showcase-count aria-live="polite">
          {pieces.length} pieces
        </p>
      </div>

      <div class="showcase-grid">
        {
          ordered.map((item) => (
            <article
              class="showcase-card"
              data-showcase-card
              data-category={item.category}
            >
              <a
                class="showcase-card__media"
                href={item.href}
                aria-label={`Open ${item.title}`}
              >
                <figure>
                  <div class="showcase-card__frame">
                    <ShowcasePreview item={item} />
                  </div>
                  <figcaption>
                    <span>{CATEGORY_LABEL[item.category]}</span>
                    <strong>{item.title}</strong>
                  </figcaption>
                </figure>
              </a>
              <div class="showcase-card__actions">
                <a
                  href="/design-ideas/"
                  aria-label={`Turn ${item.title} into a design recipe`}
                >
                  Recipe <span aria-hidden="true">↗</span>
                </a>
                <button
                  type="button"
                  data-showcase-copy={item.href}
                  aria-label={`Copy link to ${item.title}`}
                >
                  Copy link
                </button>
              </div>
            </article>
          ))
        }
      </div>

      <p class="showcase-empty" data-showcase-empty hidden>Nothing in this category.</p>
    </main>

    <footer class="showcase-footer">
      <span>ascii-things / live archive</span>
      <span>
        <a href="/library/">Browse the library ↗</a>
        <a href="/design-ideas/">Steal a layout ↗</a>
      </span>
    </footer>

    <BackToTop tone="dark" />

    <script>
      const root = document.querySelector<HTMLElement>("[data-showcase]");

      if (root) {
        const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-showcase-card]"));
        const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-showcase-filter]"));
        const count = root.querySelector<HTMLElement>("[data-showcase-count]");
        const empty = root.querySelector<HTMLElement>("[data-showcase-empty]");
        const copyButtons = Array.from(
          root.querySelectorAll<HTMLButtonElement>("[data-showcase-copy]"),
        );
        const liveHosts = Array.from(root.querySelectorAll<HTMLElement>("[data-live-tag]"));
        const valid = new Set(buttons.map((button) => button.dataset.showcaseFilter));

        let active = "all";
        let sceneLoader: Promise<unknown> | undefined;
        let surfaceLoader: Promise<unknown> | undefined;

        const loadScenes = () => (sceneLoader ??= import("ascii-things/element"));
        const loadSurfaces = () => (surfaceLoader ??= import("ascii-things/webgl/element"));

        const mountHost = async (host: HTMLElement) => {
          if (host.dataset.mounted === "true" || host.dataset.mounted === "pending") return;

          const tag = host.dataset.liveTag;
          if (!tag) return;

          host.dataset.mounted = "pending";

          try {
            await (tag === "ascii-surface" ? loadSurfaces() : loadScenes());
          } catch {
            delete host.dataset.mounted;
            return;
          }

          if (host.dataset.mounted !== "pending") return;

          const element = document.createElement(tag);
          const attrs = JSON.parse(host.dataset.liveAttrs ?? "{}") as Record<string, string>;

          for (const [name, value] of Object.entries(attrs)) {
            element.setAttribute(name, value);
          }

          element.setAttribute("aria-hidden", "true");
          element.setAttribute("paused", "");
          host.replaceChildren(element);
          host.dataset.mounted = "true";

          requestAnimationFrame(() => {
            element.removeAttribute("paused");
          });
        };

        const unmountHost = (host: HTMLElement) => {
          host.replaceChildren();
          delete host.dataset.mounted;
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const host = entry.target as HTMLElement;
              if (entry.isIntersecting) void mountHost(host);
              else unmountHost(host);
            }
          },
          { rootMargin: "0px 0px", threshold: 0.1 },
        );

        for (const host of liveHosts) observer.observe(host);

        const readFilter = () => {
          const value = new URLSearchParams(window.location.search).get("type");
          return value && valid.has(value) ? value : "all";
        };

        const apply = () => {
          const matching = cards.filter(
            (card) => active === "all" || card.dataset.category === active,
          );
          const visibleSet = new Set(matching);

          for (const card of cards) {
            card.hidden = !visibleSet.has(card);
          }

          for (const button of buttons) {
            const on = button.dataset.showcaseFilter === active;
            button.classList.toggle("is-active", on);
            button.setAttribute("aria-pressed", on ? "true" : "false");
          }

          if (count) {
            count.textContent = `${matching.length} ${matching.length === 1 ? "piece" : "pieces"}`;
          }

          if (empty) {
            empty.hidden = matching.length > 0;
          }
        };

        const setFilter = (filter: string, push: boolean) => {
          active = filter && valid.has(filter) ? filter : "all";
          apply();

          if (push) {
            const url = new URL(window.location.href);
            if (active === "all") {
              url.searchParams.delete("type");
            } else {
              url.searchParams.set("type", active);
            }
            window.history.pushState({}, "", url);
          }
        };

        for (const button of buttons) {
          button.addEventListener("click", () => {
            setFilter(button.dataset.showcaseFilter || "all", true);
          });
        }

        for (const button of copyButtons) {
          button.addEventListener("click", async () => {
            const path = button.dataset.showcaseCopy;
            if (!path) return;

            const url = new URL(path, window.location.origin).href;
            let copied = false;

            try {
              await navigator.clipboard.writeText(url);
              copied = true;
            } catch {
              const area = document.createElement("textarea");
              area.value = url;
              area.setAttribute("readonly", "");
              area.style.position = "fixed";
              area.style.opacity = "0";
              document.body.append(area);
              area.select();
              copied = document.execCommand("copy");
              area.remove();
            }

            const original = button.textContent ?? "Copy link";
            button.textContent = copied ? "Copied" : "Failed";
            window.setTimeout(() => {
              button.textContent = original;
            }, 1600);
          });
        }

        window.addEventListener("popstate", () => setFilter(readFilter(), false));
        setFilter(readFilter(), false);
      }
    </script>
  </body>
</html>
