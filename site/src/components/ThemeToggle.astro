---
interface Props {
  class?: string;
  light?: string;
  dark?: string;
}

const { class: className, light = "#f3eee4", dark = "#070809" } = Astro.props;
---

<button
  class:list={["theme-toggle", "theme-toggle-shared", className]}
  type="button"
  data-theme-toggle
  aria-label="Switch to light mode"
>
  <span class="theme-toggle-sun" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
      <circle cx="8" cy="8" r="3.2"></circle>
      <path d="M8 1.5v1.4M8 13.1v1.4M1.5 8h1.4M13.1 8h1.4M3.4 3.4l1 1M11.6 11.6l1 1M12.6 3.4l-1 1M4.4 11.6l-1 1"
      ></path>
    </svg>
  </span>
  <span class="theme-toggle-moon" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
      <path d="M13.2 9.8A5.6 5.6 0 0 1 6.2 2.8a5.6 5.6 0 1 0 7 7Z"></path>
    </svg>
  </span>
</button>

<script is:inline define:vars={{ lightColor: light, darkColor: dark }}>
  (() => {
    const button = document.querySelector("[data-theme-toggle]");
    if (!(button instanceof HTMLButtonElement)) return;

    const sync = () => {
      const theme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
      button.setAttribute("aria-label", theme === "light" ? "Switch to dark mode" : "Switch to light mode");
    };

    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      document.documentElement.style.colorScheme = next;
      try {
        localStorage.setItem("starlight-theme", next);
        localStorage.setItem("ascii-things-theme", next);
      } catch {}
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", next === "light" ? lightColor : darkColor);
      sync();
      window.dispatchEvent(new CustomEvent("ascii-theme-change", { detail: next }));
    });

    sync();
  })();
</script>

<style>
  .theme-toggle-shared {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      opacity 160ms ease;
    opacity: 0.72;
  }

  .theme-toggle-shared:hover,
  .theme-toggle-shared:focus-visible {
    border-color: currentColor;
    opacity: 1;
    outline: none;
  }

  .theme-toggle-shared svg {
    width: 14px;
    height: 14px;
  }

  .theme-toggle-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .theme-toggle-sun {
    display: inline-flex;
  }

  :global(html[data-theme="light"]) .theme-toggle-moon {
    display: none;
  }
</style>
