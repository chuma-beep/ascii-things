---
import { AsciiSurface } from "ascii-things/webgl/react";

const kanjiFont = "'Noto Serif CJK JP', 'Yu Mincho', 'Hiragino Mincho ProN', serif";

const items = [
  {
    variant: "field" as const,
    id: "field",
    title: "Kanji field",
    family: "Type",
    description: "A drifting glyph field with a 漢字 wordmark and an orange scan band.",
    glyphs: "永龍風水火土空海月花鳥",
    text: "漢字",
    density: 0.24,
    cell: 10,
    foreground: "#f4ead6",
    accent: "#ff7a1a",
    code: '<AsciiSurface text="漢字" glyphs="永龍風水火土空海月花鳥" />',
  },
  {
    variant: "torus-3d" as const,
    id: "torus-3d",
    title: "Kanji torus",
    family: "3D",
    description: "A raymarched torus wrapped in a slow orbit of kanji.",
    glyphs: "永遠風水火",
    text: "",
    density: 0.3,
    cell: 9,
    foreground: "#e8d5a8",
    accent: "#ffb347",
    code: '<AsciiSurface variant="torus-3d" glyphs="永遠風水火" />',
  },
  {
    variant: "cube-3d" as const,
    id: "cube-3d",
    title: "Kanji cube",
    family: "3D",
    description: "A rounded cube with a cool palette and a few quiet characters.",
    glyphs: "空海山月",
    text: "",
    density: 0.3,
    cell: 9,
    foreground: "#a9d6ff",
    accent: "#7fbcff",
    code: '<AsciiSurface variant="cube-3d" glyphs="空海山月" />',
  },
  {
    variant: "helix-3d" as const,
    id: "helix-3d",
    title: "Kanji helix",
    family: "3D",
    description: "A double helix turning through a field of bright characters.",
    glyphs: "龍神光",
    text: "",
    density: 0.32,
    cell: 9,
    foreground: "#c7e8a4",
    accent: "#7ee787",
    code: '<AsciiSurface variant="helix-3d" glyphs="龍神光" />',
  },
  {
    variant: "glyph-rain" as const,
    id: "glyph-rain",
    title: "Kanji rain",
    family: "Weather",
    description: "Columns of rain, wind, water, and sound falling through the dark.",
    glyphs: "雨風水音",
    text: "",
    density: 0.38,
    cell: 12,
    foreground: "#b8d8ff",
    accent: "#7fbcff",
    code: '<AsciiSurface variant="glyph-rain" glyphs="雨風水音" />',
  },
  {
    variant: "ripple" as const,
    id: "ripple",
    title: "Kanji pond",
    family: "Water",
    description: "Concentric rings of water, wave, moon, and shadow characters.",
    glyphs: "水波月影",
    text: "",
    density: 0.3,
    cell: 12,
    foreground: "#b8d8ff",
    accent: "#7fbcff",
    code: '<AsciiSurface variant="ripple" glyphs="水波月影" />',
  },
  {
    variant: "tunnel" as const,
    id: "tunnel",
    title: "Kanji gate",
    family: "Architecture",
    description: "A corridor of gates and lantern light made from 門, 光, and 道.",
    glyphs: "門光道",
    text: "",
    density: 0.3,
    cell: 12,
    foreground: "#ffd7a8",
    accent: "#ff7a1a",
    code: '<AsciiSurface variant="tunnel" glyphs="門光道" />',
  },
  {
    variant: "galaxy" as const,
    id: "galaxy",
    title: "Kanji galaxy",
    family: "Sky",
    description: "A spiral of star, moon, night, and light characters.",
    glyphs: "星月夜光",
    text: "",
    density: 0.3,
    cell: 11,
    foreground: "#d8d0ff",
    accent: "#a78bfa",
    code: '<AsciiSurface variant="galaxy" glyphs="星月夜光" />',
  },
  {
    variant: "koi" as const,
    id: "koi",
    title: "Kanji koi",
    family: "Water",
    description: "A koi silhouette with a forked tail and fins, drawn in water characters.",
    glyphs: "鯉水波泳錦",
    text: "",
    density: 0.34,
    cell: 10,
    foreground: "#bff0e0",
    accent: "#34d399",
    code: '<AsciiSurface variant="koi" glyphs="鯉水波泳錦" />',
  },
  {
    variant: "moon" as const,
    id: "moon",
    title: "Kanji moon",
    family: "Sky",
    description: "A full moon with dark craters, drawn in moon and night characters.",
    glyphs: "月夜光星面斑影",
    text: "",
    density: 0.28,
    cell: 11,
    foreground: "#e8e4ff",
    accent: "#b8c7ff",
    code: '<AsciiSurface variant="moon" glyphs="月夜光星面斑影" />',
  },
  {
    variant: "terrain" as const,
    id: "mountain",
    title: "Kanji mountain",
    family: "Land",
    description: "A green terrain of mountain, wind, rock, and cloud characters.",
    glyphs: "山風岩雲",
    text: "",
    density: 0.3,
    cell: 11,
    foreground: "#d8e8d0",
    accent: "#86efac",
    code: '<AsciiSurface variant="terrain" glyphs="山風岩雲" />',
  },
  {
    variant: "caustics" as const,
    id: "wave",
    title: "Kanji wave",
    family: "Sea",
    description: "Caustic water lines made from wave, billow, sea, and open-water characters.",
    glyphs: "波濤海沖",
    text: "",
    density: 0.32,
    cell: 12,
    foreground: "#c7e8ff",
    accent: "#7fbcff",
    code: '<AsciiSurface variant="caustics" glyphs="波濤海沖" />',
  },
];
---


<div class="kanji-gallery">
  {
    items.map((item) => (
      <article class="kanji-card" id={item.id}>
        <div class="kanji-card__preview">
          <AsciiSurface
            client:visible
            variant={item.variant}
            text={item.text}
            glyphs={item.glyphs}
            density={item.density}
            cell={item.cell}
            foreground={item.foreground}
            accent={item.accent}
            fontFamily={kanjiFont}
            label={`${item.title} ASCII kanji demo`}
            style={{ height: "280px" }}
          />
        </div>
        <div class="kanji-card__body">
          <p class="kanji-card__family">{item.family}</p>
          <h2>{item.title}</h2>
          <p class="kanji-card__description">{item.description}</p>
          <code>{item.code}</code>
        </div>
      </article>
    ))
  }
</div>

<style>
  .kanji-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }

  .kanji-card {
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1rem);
    overflow: hidden;
    border: 1px solid rgba(236, 232, 223, 0.16);
    background: #0b0d0f;
  }

  .kanji-card__preview {
    height: 280px;
    overflow: hidden;
    border-bottom: 1px solid rgba(236, 232, 223, 0.1);
    background: #050607;
  }

  .kanji-card__preview :global(canvas) {
    display: block;
    width: 100%;
    height: 280px !important;
  }

  .kanji-card__body {
    padding: 0.9rem 1rem 1rem;
  }

  .kanji-card__family {
    margin: 0 0 0.35rem;
    color: #ff7a1a;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .kanji-card h2 {
    margin: 0;
    color: #ece8df;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .kanji-card__description {
    min-height: 3.8em;
    margin: 0.45rem 0 0.7rem;
    color: rgba(236, 232, 223, 0.58);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .kanji-card code {
    color: rgba(236, 232, 223, 0.45);
    font-size: 0.62rem;
  }

  @media (max-width: 72rem) {
    .kanji-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
