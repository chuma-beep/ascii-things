---
import { AsciiSurface } from "ascii-things/webgl/react";
import CopyCode from "./CopyCode.astro";
import KanjiStatic from "./KanjiStatic.astro";
import { KANJI_STUDIES } from "../data/kanji";

const kanjiFont = "'Noto Serif CJK JP', 'Yu Mincho', 'Hiragino Mincho ProN', serif";
---

<div class="kanji-gallery">
  {
    KANJI_STUDIES.map((item) => (
      <article class="kanji-card" id={item.id}>
        <div class="kanji-card__preview">
          {item.kind === "webgl" ? (
            <AsciiSurface
              client:visible
              variant={item.variant}
              text={item.text}
              glyphs={item.glyphs}
              density={item.density}
              cell={item.cell}
              pointer={false}
              foreground={item.foreground}
              accent={item.accent}
              fontFamily={kanjiFont}
              label={`${item.title} ASCII kanji demo`}
              style={{ height: "280px" }}
            />
          ) : (
            <KanjiStatic art={item.art} />
          )}
        </div>
        <div class="kanji-card__body">
          <p class="kanji-card__family">{item.family}</p>
          <h2>
            <a href={`/kanji/${item.slug}/`}>{item.title}</a>
          </h2>
          <p class="kanji-card__description">{item.description}</p>
          <div class="kanji-card__actions">
            <CopyCode
              value={item.copy ?? item.code}
              display={item.code}
              label={item.title}
            />
            <a class="kanji-card__open" href={`/kanji/${item.slug}/`}>
              Open study ↗
            </a>
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .kanji-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }

  .kanji-card {
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1rem);
    overflow: hidden;
    border: 1px solid rgba(236, 232, 223, 0.16);
    background: #0b0d0f;
  }

  .kanji-card__preview {
    height: 280px;
    overflow: hidden;
    border-bottom: 1px solid rgba(236, 232, 223, 0.1);
    background: #050607;
  }

  .kanji-card__preview :global(canvas) {
    display: block;
    width: 100%;
    height: 280px !important;
  }

  .kanji-card__preview :global(.kanji-static) {
    height: 280px;
  }

  .kanji-card__body {
    padding: 0.9rem 1rem 1rem;
  }

  .kanji-card__family {
    margin: 0 0 0.35rem;
    color: #ff7a1a;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .kanji-card h2 {
    margin: 0;
    color: #ece8df;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .kanji-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .kanji-card h2 a:hover {
    color: #ff7a1a;
  }

  .kanji-card__description {
    min-height: 3.8em;
    margin: 0.45rem 0 0.7rem;
    color: rgba(236, 232, 223, 0.58);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .kanji-card__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kanji-card__actions :global(.copy-code) {
    flex: 1;
    min-width: 0;
  }

  .kanji-card__open {
    flex: none;
    color: #ff7a1a;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .kanji-card__open:hover {
    color: #ffd7a8;
  }

  @media (max-width: 72rem) {
    .kanji-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
