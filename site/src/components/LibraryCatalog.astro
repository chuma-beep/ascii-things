---
import { LIBRARY } from "../data/library";

const filters = [
  { id: "all", label: "All", count: LIBRARY.length },
  { id: "scene", label: "Scenes", count: LIBRARY.filter((item) => item.kind === "scene").length },
  {
    id: "webgl",
    label: "WebGL",
    count: LIBRARY.filter((item) => item.kind === "webgl").length,
  },
  {
    id: "component",
    label: "Components",
    count: LIBRARY.filter((item) => item.kind === "component").length,
  },
  { id: "tool", label: "Tools", count: LIBRARY.filter((item) => item.kind === "tool").length },
];
---

<section class="library-catalog" aria-label="Searchable library">
  <div class="library-toolbar">
    <label class="library-search">
      <span class="library-sr">Search the library</span>
      <input
        id="library-search"
        type="search"
        placeholder="Search scenes, WebGL, components, tools…"
        data-library-search
      />
    </label>
    <div class="library-filters" role="group" aria-label="Filter by type">
      {
        filters.map((filter, index) => (
          <button
            type="button"
            data-filter={filter.id}
            class={index === 0 ? "is-active" : undefined}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {filter.label}
            <span>{filter.count}</span>
          </button>
        ))
      }
    </div>
    <p class="library-count" data-library-count>{LIBRARY.length} items</p>
  </div>

  <div class="library-grid">
    {
      LIBRARY.map((item) => (
        <a
          class="library-card"
          href={item.href}
          data-kind={item.kind}
          data-search={`${item.title} ${item.description} ${item.tags.join(" ")}`.toLowerCase()}
        >
          <span class="library-card__kind">{item.kind}</span>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
          <ul class="library-card__tags" aria-label="Tags">
            {item.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <span class="library-card__open">
            Open <span aria-hidden="true">↗</span>
          </span>
        </a>
      ))
    }
  </div>

  <p class="library-empty" data-library-empty hidden>No items match that search.</p>
</section>

<script>
  const root = document.querySelector(".library-catalog");

  if (root) {
    const search = root.querySelector<HTMLInputElement>("[data-library-search]");
    const buttons = Array.from(root.querySelectorAll("[data-filter]"));
    const cards = Array.from(root.querySelectorAll(".library-card"));
    const count = root.querySelector("[data-library-count]");
    const empty = root.querySelector("[data-library-empty]");
    const filterIds = new Set(
      buttons.map((button) => button.dataset.filter).filter((id): id is string => Boolean(id)),
    );
    let active = "all";

    const apply = () => {
      const query = (search?.value || "").trim().toLowerCase();
      let shown = 0;

      cards.forEach((card) => {
        const matchesKind = active === "all" || card.dataset.kind === active;
        const matchesQuery = !query || (card.dataset.search || "").includes(query);
        const visible = matchesKind && matchesQuery;
        card.hidden = !visible;
        if (visible) shown++;
      });

      if (count) count.textContent = `${shown} item${shown === 1 ? "" : "s"}`;
      if (empty) empty.hidden = shown !== 0;
    };

    const readFilter = () => {
      const type = new URLSearchParams(window.location.search).get("type");
      return type && filterIds.has(type) ? type : "all";
    };

    const setActive = (next: string, push = false) => {
      active = filterIds.has(next) ? next : "all";
      buttons.forEach((button) => {
        const on = button.dataset.filter === active;
        button.classList.toggle("is-active", on);
        button.setAttribute("aria-pressed", String(on));
      });
      apply();

      if (!push) return;
      const url = new URL(window.location.href);
      if (active === "all") url.searchParams.delete("type");
      else url.searchParams.set("type", active);
      window.history.pushState({}, "", url);
    };

    search?.addEventListener("input", apply);

    const focusFromHash = () => {
      if (window.location.hash === "#library-search") search?.focus();
    };
    focusFromHash();
    window.addEventListener("hashchange", focusFromHash);

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        setActive(button.dataset.filter || "all", true);
      });
    });

    window.addEventListener("popstate", () => setActive(readFilter(), false));

    setActive(readFilter(), false);
  }
</script>

<style>
  .library-catalog {
    margin: 1.5rem 0 2.5rem;
  }

  .library-toolbar {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5, rgba(0, 0, 0, 0.15));
    background: var(--sl-color-bg-nav, #f5f3ef);
  }

  .library-search input {
    width: 100%;
    border: 1px solid var(--sl-color-gray-5, rgba(0, 0, 0, 0.15));
    border-radius: 0;
    background: var(--sl-color-bg, #fff);
    color: var(--sl-color-text, #1a1a1a);
    font: inherit;
    padding: 0.7rem 0.85rem;
  }

  .library-search input:focus {
    outline: 1px solid var(--sl-color-text-accent, #ff7a1a);
    outline-offset: 0;
  }

  .library-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .library-filters button {
    border: 1px solid var(--sl-color-gray-5, rgba(0, 0, 0, 0.15));
    border-radius: 0;
    background: transparent;
    color: var(--sl-color-gray-3, rgba(0, 0, 0, 0.6));
    cursor: pointer;
    font: inherit;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    padding: 0.42rem 0.55rem;
    text-transform: uppercase;
  }

  .library-filters button.is-active {
    border-color: var(--sl-color-text-accent, #ff7a1a);
    color: var(--sl-color-text-accent, #ff7a1a);
  }

  .library-filters button span {
    margin-left: 0.3rem;
    opacity: 0.55;
  }

  .library-count {
    margin: 0;
    color: var(--sl-color-gray-3, rgba(0, 0, 0, 0.6));
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .library-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .library-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-height: 13rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5, rgba(0, 0, 0, 0.15));
    background: var(--sl-color-bg, #fff);
    color: var(--sl-color-text, #1a1a1a);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .library-card:hover {
    border-color: var(--sl-color-text-accent, #ff7a1a);
    transform: translateY(-2px);
  }

  .library-card__kind {
    color: var(--sl-color-text-accent, #ff7a1a);
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .library-card h2 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.25;
  }

  .library-card p {
    margin: 0;
    color: var(--sl-color-gray-3, rgba(0, 0, 0, 0.6));
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .library-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .library-card__tags li {
    border: 1px solid var(--sl-color-gray-6, rgba(0, 0, 0, 0.1));
    color: var(--sl-color-gray-3, rgba(0, 0, 0, 0.6));
    font-family: var(--sl-font-mono);
    font-size: 0.56rem;
    padding: 0.14rem 0.3rem;
  }

  .library-card__open {
    margin-top: auto;
    color: var(--sl-color-text-accent, #ff7a1a);
    font-family: var(--sl-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .library-empty {
    margin-top: 1rem;
    color: var(--sl-color-gray-3, rgba(0, 0, 0, 0.6));
  }

  .library-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 72rem) {
    .library-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 42rem) {
    .library-grid {
      grid-template-columns: 1fr;
    }
  }
  .library-card[hidden] {
    display: none;
  }
</style>
