---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

<svg
  class:list={["logo-mark", className]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`logo-mark-tile-${uid}`} x1="5" y1="2" x2="27" y2="30" gradientUnits="userSpaceOnUse">
      <stop stop-color="#1b1d20" />
      <stop offset="0.52" stop-color="#070809" />
      <stop offset="1" stop-color="#000000" />
    </linearGradient>
    <linearGradient id={`logo-mark-sheen-${uid}`} x1="7" y1="3" x2="20" y2="20" gradientUnits="userSpaceOnUse">
      <stop stop-color="#fff" stop-opacity="0.18" />
      <stop offset="0.7" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <linearGradient id={`logo-mark-accent-${uid}`} x1="6" y1="6" x2="10" y2="10" gradientUnits="userSpaceOnUse">
      <stop stop-color="#ffa260" />
      <stop offset="1" stop-color="#ff7a1a" />
    </linearGradient>
  </defs>

  <rect x="1" y="1" width="30" height="30" rx="9" fill={`url(#logo-mark-tile-${uid})`} />
  <rect x="1.5" y="1.5" width="29" height="29" rx="8.5" stroke="#fff" stroke-opacity="0.12" />
  <rect x="2" y="2" width="28" height="28" rx="8" fill={`url(#logo-mark-sheen-${uid})`} />

  <g fill="#6d675e">
    <rect x="7" y="7" width="5" height="5" rx="1" />
    <rect x="13.5" y="7" width="5" height="5" rx="1" />
    <rect x="20" y="7" width="5" height="5" rx="1" />
    <rect x="7" y="13.5" width="5" height="5" rx="1" />
    <rect x="20" y="13.5" width="5" height="5" rx="1" />
    <rect x="7" y="20" width="5" height="5" rx="1" />
    <rect x="13.5" y="20" width="5" height="5" rx="1" />
    <rect x="20" y="20" width="5" height="5" rx="1" />
  </g>

  <rect x="7" y="7" width="5" height="5" rx="1" class="logo-mark__scan" fill={`url(#logo-mark-accent-${uid})`} />
  <rect x="20" y="20" width="5" height="5" rx="1" fill="#ff7a1a" fill-opacity="0.22" />
</svg>

<style>
  .logo-mark {
    display: block;
    flex: 0 0 auto;
    width: 1.35rem;
    height: 1.35rem;
    filter: drop-shadow(0 3px 7px rgba(0, 0, 0, 0.22));
  }

  .logo-mark__scan {
    animation: logo-mark-scan 5.2s steps(1, end) infinite;
    will-change: transform;
  }

  @keyframes logo-mark-scan {
    0% { transform: translate(0, 0); }
    12.5% { transform: translate(6.5px, 0); }
    25% { transform: translate(13px, 0); }
    37.5% { transform: translate(13px, 6.5px); }
    50% { transform: translate(13px, 13px); }
    62.5% { transform: translate(6.5px, 13px); }
    75% { transform: translate(0, 13px); }
    87.5% { transform: translate(0, 6.5px); }
    100% { transform: translate(0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-mark__scan {
      animation: none;
      transform: translate(0, 0);
    }
  }
</style>
