---
const { showDocsMenu = false } = Astro.props;
const path = Astro.url.pathname;

const browse = [
  { num: "01", label: "Library", href: "/library/" },
  { num: "02", label: "Showcase", href: "/showcase/" },
  { num: "03", label: "Scenes", href: "/scenes/" },
  { num: "04", label: "WebGL", href: "/webgl/" },
  { num: "05", label: "Components", href: "/components/" },
  { num: "06", label: "Kanji Lab", href: "/kanji/" },
];

const docs = [
  { num: "07", label: "Guide", href: "/guide/" },
  { num: "08", label: "API", href: "/api/" },
  { num: "09", label: "Playground", href: "/playground/" },
];

const isActive = (href: string) =>
  href !== "/" && (path === href || path.startsWith(href));
---

<div class="mobile-nav" data-mobile-nav>
  <button
    class="mobile-nav__toggle"
    type="button"
    aria-label="Open navigation"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
    data-mobile-nav-toggle
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <button
    class="mobile-nav__scrim"
    type="button"
    tabindex="-1"
    aria-hidden="true"
    data-mobile-nav-scrim
    hidden
  ></button>

  <div
    class="mobile-nav__panel"
    id="mobile-nav-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    data-mobile-nav-panel
    hidden
  >
    <div class="mobile-nav__top">
      <span class="mobile-nav__eyebrow">Index / 09</span>
      <button
        class="mobile-nav__close"
        type="button"
        aria-label="Close navigation"
        data-mobile-nav-close
      >
        ×
      </button>
    </div>

    <nav class="mobile-nav__links" aria-label="Mobile primary">
      <p class="mobile-nav__group">Browse</p>
      {
        browse.map((item) => (
          <a
            href={item.href}
            class:list={["mobile-nav__link", { "is-active": isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <span class="mobile-nav__num">{item.num}</span>
            <span>{item.label}</span>
          </a>
        ))
      }

      <p class="mobile-nav__group">Docs</p>
      {
        showDocsMenu && (
          <button class="mobile-nav__link mobile-nav__link--button" type="button" data-mobile-nav-docs>
            <span class="mobile-nav__num">↳</span>
            <span>Docs contents</span>
            <span class="mobile-nav__arrow">↗</span>
          </button>
        )
      }
      {
        docs.map((item) => (
          <a
            href={item.href}
            class:list={["mobile-nav__link", { "is-active": isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <span class="mobile-nav__num">{item.num}</span>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="mobile-nav__foot">
      <a href="/library/#library-search">Search library ↗</a>
      <a href="https://github.com/chuma-beep/ascii-things">GitHub ↗</a>
    </div>
  </div>
</div>

<style>
  .mobile-nav {
    --mn-bg: var(--sl-color-bg-nav, #070809);
    --mn-fg: var(--sl-color-text, #ece8df);
    --mn-muted: var(--sl-color-gray-3, #8b877f);
    --mn-line: var(--sl-color-hairline, rgba(236, 232, 223, 0.16));
    --mn-accent: var(--sl-color-accent, #ff7a1a);
    --mn-panel-width: min(22rem, calc(100vw - 1.5rem));
  }

  .mobile-nav__toggle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--mn-line);
    background: transparent;
    color: var(--mn-fg);
    cursor: pointer;
  }

  .mobile-nav__toggle span {
    display: block;
    width: 1rem;
    height: 1px;
    background: currentColor;
  }

  .mobile-nav__toggle:hover,
  .mobile-nav__toggle:focus-visible {
    border-color: var(--mn-accent);
    color: var(--mn-accent);
  }

  .mobile-nav__scrim {
    position: fixed;
    inset: 0;
    z-index: 90;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(0, 0, 0, 0.58);
    cursor: default;
  }

  .mobile-nav__panel {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 100;
    display: flex;
    flex-direction: column;
    width: var(--mn-panel-width);
    height: 100dvh;
    padding:
      max(1.2rem, env(safe-area-inset-top))
      1.2rem
      max(1.2rem, env(safe-area-inset-bottom));
    overflow-y: auto;
    border-left: 1px solid var(--mn-line);
    background: var(--mn-bg);
    color: var(--mn-fg);
    box-shadow: -30px 0 80px rgba(0, 0, 0, 0.42);
    animation: mobile-nav-in 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .mobile-nav__panel[hidden],
  .mobile-nav__scrim[hidden] {
    display: none;
  }

  .mobile-nav__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--mn-line);
  }

  .mobile-nav__eyebrow {
    color: var(--mn-accent);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .mobile-nav__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--mn-line);
    background: transparent;
    color: var(--mn-fg);
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .mobile-nav__close:hover,
  .mobile-nav__close:focus-visible {
    border-color: var(--mn-accent);
    color: var(--mn-accent);
  }

  .mobile-nav__links {
    display: grid;
    gap: 0;
    padding-top: 0.9rem;
  }

  .mobile-nav__group {
    margin: 1.1rem 0 0.35rem;
    color: var(--mn-muted);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .mobile-nav__group:first-child {
    margin-top: 0;
  }

  .mobile-nav__link {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    min-height: 3.25rem;
    border-bottom: 1px solid var(--mn-line);
    color: var(--mn-fg);
    font-size: 0.78rem;
    letter-spacing: 0.13em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .mobile-nav__link:hover,
  .mobile-nav__link:focus-visible,
  .mobile-nav__link.is-active {
    color: var(--mn-accent);
    background: color-mix(in srgb, var(--mn-accent) 8%, transparent);
  }

  .mobile-nav__link.is-active {
    box-shadow: inset 2px 0 0 var(--mn-accent);
  }

  .mobile-nav__num {
    color: var(--mn-muted);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
  }

  .mobile-nav__link.is-active .mobile-nav__num {
    color: var(--mn-accent);
  }

  .mobile-nav__link--button {
    width: 100%;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--mn-line);
    background: transparent;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.13em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mobile-nav__link--button .mobile-nav__num {
    font-size: 0.8rem;
  }

  .mobile-nav__arrow {
    color: var(--mn-accent);
  }

  .mobile-nav__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.4rem;
    color: var(--mn-muted);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobile-nav__foot a {
    color: var(--mn-muted);
    text-decoration: none;
  }

  .mobile-nav__foot a:hover,
  .mobile-nav__foot a:focus-visible {
    color: var(--mn-accent);
  }

  :global(html.mobile-nav-open) {
    overflow: hidden;
  }

  @keyframes mobile-nav-in {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav__panel {
      animation: none;
    }
  }
</style>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-mobile-nav]");

  roots.forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>("[data-mobile-nav-toggle]");
    const panel = root.querySelector<HTMLElement>("[data-mobile-nav-panel]");
    const scrim = root.querySelector<HTMLElement>("[data-mobile-nav-scrim]");
    const closeButton = root.querySelector<HTMLButtonElement>("[data-mobile-nav-close]");
    const docsButton = root.querySelector<HTMLButtonElement>("[data-mobile-nav-docs]");
    const sidebar = document.querySelector<HTMLElement>("#starlight__sidebar");

    if (!toggle || !panel || !scrim) return;

    let lastFocused: HTMLElement | null = null;

    const syncSidebar = () => {
      document.documentElement.classList.toggle(
        "starlight-sidebar-open",
        Boolean(sidebar?.matches(":popover-open")),
      );
    };

    sidebar?.addEventListener("toggle", () => {
      syncSidebar();
      if (!sidebar.matches(":popover-open")) toggle.focus();
    });
    syncSidebar();

    const focusable = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]):not([tabindex="-1"])',
        ),
      );

    const close = (restoreFocus = true) => {
      panel.hidden = true;
      scrim.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      document.documentElement.classList.remove("mobile-nav-open");
      if (restoreFocus) (lastFocused ?? toggle).focus();
    };

    const open = () => {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.hidden = false;
      scrim.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add("mobile-nav-open");
      requestAnimationFrame(() => closeButton?.focus());
    };

    toggle.addEventListener("click", open);
    closeButton?.addEventListener("click", () => close());
    scrim.addEventListener("click", () => close());

    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a[href]")) close(false);
    });

    docsButton?.addEventListener("click", () => {
      close(false);
      if (!sidebar) return;
      const popover = sidebar as HTMLElement & { showPopover?: () => void };
      if (typeof popover.showPopover === "function") popover.showPopover();
      syncSidebar();
    });

    document.addEventListener("keydown", (event) => {
      if (panel.hidden) return;

      if (event.key === "Escape") {
        event.preventDefault();
        close();
        return;
      }

      if (event.key !== "Tab") return;

      const items = focusable();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  });
</script>
