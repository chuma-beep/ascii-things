---
const faces = [
  { name: "front", glyphs: "永龍風水火土空海月" },
  { name: "right", glyphs: "花鳥山川光雨雪雲星" },
  { name: "top", glyphs: "心夢愛和美真善力魂" },
  { name: "left", glyphs: "木林森石天地日夜春" },
  { name: "back", glyphs: "夏秋冬朝夕東西南北" },
  { name: "bottom", glyphs: "金銀銅鉄玉珠音色香" },
];

const asciiGlyphs = ["+", "-", "/", "\\", "|", ".", ":", "*", "="];
---

<div class="design-gallery">
  <article class="design-piece" id="rubik">
    <header class="design-piece__head">
      <p class="design-piece__meta">3D object / CSS / Kanji + ASCII</p>
      <h2>Rubik's cube</h2>
      <p>
        A black-and-white ASCII field cube. Each face is a 3×3 grid of tiles; every tile holds a
        kanji at its center, surrounded by a field of ASCII marks. The cube turns continuously in
        perspective.
      </p>
    </header>
    <div class="design-piece__stage design-piece__stage--cube">
      <div
        class="rubik-scene"
        role="img"
        aria-label="A rotating black-and-white ASCII cube with kanji fields"
      >
        <div class="rubik-cube" aria-hidden="true">
          {
            faces.map((face) => (
              <div class={`rubik-face rubik-face--${face.name}`}>
                {Array.from(face.glyphs).map((kanji, tileIndex) => (
                  <div class="rubik-tile">
                    {Array.from({ length: 9 }).map((_, cellIndex) =>
                      cellIndex === 4 ? (
                        <span class="rubik-cell rubik-kanji">{kanji}</span>
                      ) : (
                        <span class="rubik-cell">
                          {asciiGlyphs[(tileIndex * 3 + cellIndex) % asciiGlyphs.length]}
                        </span>
                      ),
                    )}
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <footer class="design-piece__foot">
      <code>CSS 3D · 54 kanji · 432 ASCII cells</code>
    </footer>
  </article>
</div>

<style>
  .design-gallery {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0 3rem;
  }

  .design-piece {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5, rgba(0, 0, 0, 0.15));
    background: #0b0d0f;
  }

  .design-piece__head {
    padding: 1.2rem 1.3rem 0;
  }

  .design-piece__meta {
    margin: 0 0 0.35rem;
    color: #ff7a1a;
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .design-piece h2 {
    margin: 0;
    color: #ece8df;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .design-piece__head p:last-child {
    max-width: 62ch;
    margin: 0.5rem 0 1rem;
    color: rgba(236, 232, 223, 0.6);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .design-piece__stage {
    overflow-x: auto;
    border-top: 1px solid rgba(236, 232, 223, 0.1);
    border-bottom: 1px solid rgba(236, 232, 223, 0.1);
    background:
      radial-gradient(circle at 50% 40%, rgba(255, 122, 26, 0.05), transparent 55%),
      #050607;
    padding: 1rem;
  }

  .design-piece__stage--cube {
    height: 380px;
    padding: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 45%, rgba(245, 241, 232, 0.06), transparent 55%),
      #050607;
  }

  .rubik-scene {
    display: grid;
    place-items: center;
    height: 100%;
    width: 100%;
    overflow: hidden;
    perspective: 1000px;
    perspective-origin: 50% 42%;
  }

  .rubik-cube {
    --cube: clamp(170px, 46vw, 215px);
    position: relative;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    transform: rotateX(-22deg) rotateY(-30deg);
    animation: rubik-spin 18s linear infinite;
  }

  .rubik-face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    padding: 3px;
    border: 1px solid rgba(245, 241, 232, 0.14);
    background: #0a0b0d;
    backface-visibility: hidden;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.65);
  }

  .rubik-tile {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #0d0e10;
    box-shadow: inset 0 0 0 1px rgba(245, 241, 232, 0.06);
  }

  .rubik-cell {
    display: grid;
    place-items: center;
    color: rgba(245, 241, 232, 0.4);
    font-family: var(--sl-font-mono);
    font-size: clamp(0.42rem, 1vw, 0.58rem);
    line-height: 1;
  }

  .rubik-kanji {
    color: #f5f1e8;
    font-family:
      "Noto Serif CJK JP", "Yu Mincho", "Hiragino Mincho ProN", "Noto Sans CJK JP", serif;
    font-size: clamp(0.62rem, 1.5vw, 0.82rem);
    font-weight: 500;
  }

  .rubik-face--front {
    transform: translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--back {
    transform: rotateY(180deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--right {
    transform: rotateY(90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--left {
    transform: rotateY(-90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--top {
    transform: rotateX(90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--cube) / 2));
  }

  .design-piece__foot {
    padding: 0.7rem 1.3rem;
  }

  .design-piece__foot code {
    color: rgba(236, 232, 223, 0.45);
    font-size: 0.62rem;
  }

  @keyframes rubik-spin {
    from {
      transform: rotateX(-22deg) rotateY(-30deg);
    }

    to {
      transform: rotateX(-22deg) rotateY(330deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rubik-cube {
      animation: none;
      transform: rotateX(-22deg) rotateY(-30deg);
    }
  }

  @media (max-width: 42rem) {
    .design-piece__stage {
      padding: 0.65rem;
    }

    .design-piece__stage--cube {
      height: 300px;
      padding: 0;
    }
  }
</style>
