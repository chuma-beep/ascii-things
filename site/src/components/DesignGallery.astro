---
const faces = [
  {
    name: "front",
    theme: "dark",
    kanji: ["永", "龍", "風", "水", "火", "土", "空", "海", "月"],
  },
  {
    name: "right",
    theme: "light",
    kanji: ["山", "川", "光", "雨", "雪", "星", "心", "夢", "愛"],
  },
  {
    name: "top",
    theme: "light",
    kanji: ["日", "天", "地", "春", "夏", "秋", "冬", "花", "鳥"],
  },
  {
    name: "left",
    theme: "dark",
    kanji: ["石", "木", "林", "森", "玉", "音", "色", "香", "力"],
  },
  {
    name: "back",
    theme: "light",
    kanji: ["金", "銀", "銅", "鉄", "朝", "夕", "東", "西", "南"],
  },
  {
    name: "bottom",
    theme: "dark",
    kanji: ["北", "魂", "真", "善", "和", "美", "心", "夢", "愛"],
  },
];

const field = (kanji: string) => `·${kanji}·\n${kanji}${kanji}${kanji}\n·${kanji}·`;
---

<div class="design-gallery">
  <article class="design-piece" id="rubik">
    <header class="design-piece__head">
      <p class="design-piece__meta">3D object / ASCII</p>
      <h2>Rubik's cube</h2>
      <p>
        A 3D cube built from six 3×3 sticker faces. Every sticker is a preformatted ASCII field
        with a kanji at its center, alternating black and white across the six faces.
      </p>
    </header>
    <div class="design-piece__stage design-piece__stage--cube">
      <div class="rubik-scene" role="img" aria-label="A rotating 3D ASCII Rubik's cube with kanji">
        <div class="rubik-cube" aria-hidden="true">
          {
            faces.map((face) => (
              <div class={`rubik-face rubik-face--${face.name} rubik-face--${face.theme}`}>
                {face.kanji.map((kanji) => (
                  <pre>{field(kanji)}</pre>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <footer class="design-piece__foot">
      <code>ASCII 3D · 6 faces · 54 stickers · 270 kanji</code>
    </footer>
  </article>
</div>

<style>
  .design-gallery {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0 3rem;
  }

  .design-piece {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5, rgba(0, 0, 0, 0.15));
    background: #0b0d0f;
  }

  .design-piece__head {
    padding: 1.2rem 1.3rem 0;
  }

  .design-piece__meta {
    margin: 0 0 0.35rem;
    color: #ff7a1a;
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .design-piece h2 {
    margin: 0;
    color: #ece8df;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .design-piece__head p:last-child {
    max-width: 62ch;
    margin: 0.5rem 0 1rem;
    color: rgba(236, 232, 223, 0.6);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .design-piece__stage {
    overflow-x: auto;
    border-top: 1px solid rgba(236, 232, 223, 0.1);
    border-bottom: 1px solid rgba(236, 232, 223, 0.1);
    background: #050607;
    padding: 1rem;
  }

  .design-piece__stage--cube {
    height: 380px;
    padding: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.04), transparent 55%),
      #050607;
  }

  .rubik-scene {
    display: grid;
    place-items: center;
    height: 100%;
    width: 100%;
    overflow: hidden;
    perspective: 1100px;
    perspective-origin: 50% 44%;
  }

  .rubik-cube {
    --cube: clamp(200px, 46vw, 240px);
    position: relative;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    transform: rotateX(-24deg) rotateY(-32deg);
    animation: rubik-rock 10s ease-in-out infinite alternate;
  }

  .rubik-face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 5px;
    padding: 6px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backface-visibility: hidden;
  }

  .rubik-face--dark {
    background: #08090b;
    color: #f5f1e8;
  }

  .rubik-face--light {
    background: #f5f1e8;
    color: #08090b;
  }

  .rubik-face pre {
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0;
    border: 1px solid currentColor;
    font-family: var(--sl-font-mono);
    font-size: clamp(0.55rem, 1.2vw, 0.82rem);
    line-height: 1.08;
    white-space: pre;
    opacity: 0.9;
  }

  .rubik-face--front {
    transform: translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--back {
    transform: rotateY(180deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--right {
    transform: rotateY(90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--left {
    transform: rotateY(-90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--top {
    transform: rotateX(90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--cube) / 2));
  }

  .design-piece__foot {
    padding: 0.7rem 1.3rem;
  }

  .design-piece__foot code {
    color: rgba(236, 232, 223, 0.45);
    font-size: 0.62rem;
  }

  @keyframes rubik-rock {
    from {
      transform: rotateX(-24deg) rotateY(-34deg);
    }

    to {
      transform: rotateX(-24deg) rotateY(34deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rubik-cube {
      animation: none;
      transform: rotateX(-24deg) rotateY(-32deg);
    }
  }

  @media (max-width: 42rem) {
    .design-piece__stage {
      padding: 0.65rem;
    }

    .design-piece__stage--cube {
      height: 320px;
      padding: 0;
    }

    .rubik-cube {
      --cube: clamp(170px, 52vw, 210px);
    }
  }
</style>
