---
const faces = [
  { name: "front", tone: "dark", glyphs: "永龍風水火土空海月" },
  { name: "right", tone: "light", glyphs: "花鳥山川光雨雪雲星" },
  { name: "top", tone: "dark", glyphs: "心夢愛和美真善力魂" },
  { name: "left", tone: "light", glyphs: "木林森石天地日夜春" },
  { name: "back", tone: "dark", glyphs: "夏秋冬朝夕東西南北" },
  { name: "bottom", tone: "light", glyphs: "金銀銅鉄玉珠音色香" },
];
---

<div class="design-gallery">
  <article class="design-piece" id="rubik">
    <header class="design-piece__head">
      <p class="design-piece__meta">3D object / CSS / Kanji</p>
      <h2>Rubik's cube</h2>
      <p>
        A black-and-white 3D cube with 54 kanji stickers. It turns continuously in perspective,
        keeping the faces and glyph grid readable.
      </p>
    </header>
    <div class="design-piece__stage design-piece__stage--cube">
      <div
        class="rubik-scene"
        role="img"
        aria-label="A rotating black-and-white 3D Rubik's cube covered in kanji"
      >
        <div class="rubik-cube" aria-hidden="true">
          {
            faces.map((face) => (
              <div class={`rubik-face rubik-face--${face.name} is-${face.tone}`}>
                {Array.from(face.glyphs).map((glyph) => (
                  <span>{glyph}</span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <footer class="design-piece__foot">
      <code>CSS 3D · 6 faces · 54 kanji</code>
    </footer>
  </article>
</div>

<style>
  .design-gallery {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0 3rem;
  }

  .design-piece {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5, rgba(0, 0, 0, 0.15));
    background: #0b0d0f;
  }

  .design-piece__head {
    padding: 1.2rem 1.3rem 0;
  }

  .design-piece__meta {
    margin: 0 0 0.35rem;
    color: #ff7a1a;
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .design-piece h2 {
    margin: 0;
    color: #ece8df;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .design-piece__head p:last-child {
    max-width: 62ch;
    margin: 0.5rem 0 1rem;
    color: rgba(236, 232, 223, 0.6);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .design-piece__stage {
    overflow-x: auto;
    border-top: 1px solid rgba(236, 232, 223, 0.1);
    border-bottom: 1px solid rgba(236, 232, 223, 0.1);
    background:
      radial-gradient(circle at 50% 40%, rgba(255, 122, 26, 0.05), transparent 55%),
      #050607;
    padding: 1rem;
  }

  .design-piece__stage--cube {
    height: 380px;
    padding: 0;
    overflow: hidden;
    background: #050607;
  }

  .rubik-scene {
    display: grid;
    place-items: center;
    height: 100%;
    width: 100%;
    overflow: hidden;
    perspective: 1000px;
    perspective-origin: 50% 42%;
  }

  .rubik-cube {
    --cube: clamp(160px, 44vw, 205px);
    position: relative;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    transform: rotateX(-22deg) rotateY(-30deg);
    animation: rubik-spin 18s linear infinite;
  }

  .rubik-face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #08090b;
    backface-visibility: hidden;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.6);
  }

  .rubik-face.is-dark {
    --sticker: #0a0a0a;
    --ink: #f5f1e8;
  }

  .rubik-face.is-light {
    --sticker: #f5f1e8;
    --ink: #0a0a0a;
  }

  .rubik-face span {
    display: grid;
    place-items: center;
    background: var(--sticker);
    color: var(--ink);
    font-family:
      "Noto Serif CJK JP", "Yu Mincho", "Hiragino Mincho ProN", "Noto Sans CJK JP", serif;
    font-size: clamp(0.72rem, 1.8vw, 1.05rem);
    font-weight: 500;
    line-height: 1;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
  }

  .rubik-face--front {
    transform: translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--back {
    transform: rotateY(180deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--right {
    transform: rotateY(90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--left {
    transform: rotateY(-90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--top {
    transform: rotateX(90deg) translateZ(calc(var(--cube) / 2));
  }

  .rubik-face--bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--cube) / 2));
  }

  .design-piece__foot {
    padding: 0.7rem 1.3rem;
  }

  .design-piece__foot code {
    color: rgba(236, 232, 223, 0.45);
    font-size: 0.62rem;
  }

  @keyframes rubik-spin {
    from {
      transform: rotateX(-22deg) rotateY(-30deg);
    }

    to {
      transform: rotateX(-22deg) rotateY(330deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rubik-cube {
      animation: none;
      transform: rotateX(-22deg) rotateY(-30deg);
    }
  }

  @media (max-width: 42rem) {
    .design-piece__stage {
      padding: 0.65rem;
    }

    .design-piece__stage--cube {
      height: 300px;
      padding: 0;
    }
  }
</style>
