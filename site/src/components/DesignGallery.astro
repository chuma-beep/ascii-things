---
import { AsciiSurface } from "ascii-things/webgl/react";
import AnimatedAscii from "./AnimatedAscii";
import { DRAGON_FRAMES, RHINO_FRAMES } from "../data/designs";
---

<div class="design-gallery">
  <article class="design-piece" id="rubik">
    <header class="design-piece__head">
      <p class="design-piece__meta">WebGL / 3D object</p>
      <h2>Rubik's cube</h2>
      <p>
        A raymarched 3×3×3 puzzle. The cube turns slowly in perspective while its top layer
        completes a quarter turn, pauses, and resets into the same solved grid.
      </p>
    </header>
    <div class="design-piece__stage design-piece__stage--webgl">
      <AsciiSurface
        client:visible
        variant="rubik-3d"
        text=""
        density={0.3}
        cell={7}
        foreground="#e8d5a8"
        accent="#ff7a1a"
        label="A moving ASCII Rubik's cube"
        style={{ height: "380px" }}
      />
    </div>
    <footer class="design-piece__foot">
      <code>{'<AsciiSurface variant="rubik-3d" />'}</code>
    </footer>
  </article>

  <article class="design-piece" id="rhino">
    <header class="design-piece__head">
      <p class="design-piece__meta">ASCII art / forest</p>
      <h2>Rhino in a forest</h2>
      <p>
        A rhino stands in a clearing between dark conifers. The tail and ear move in two
        alternating frames; fireflies mark the edge of the treeline.
      </p>
    </header>
    <div class="design-piece__stage">
      <AnimatedAscii
        client:visible
        frames={RHINO_FRAMES}
        interval={1700}
        label="ASCII art of a rhino standing in a forest"
        className="design-art"
      />
    </div>
    <footer class="design-piece__foot">
      <code>120 × 42 glyphs · 2 frames</code>
    </footer>
  </article>

  <article class="design-piece" id="dragon">
    <header class="design-piece__head">
      <p class="design-piece__meta">ASCII art / flight</p>
      <h2>Dragon</h2>
      <p>
        A dragon crosses a mountain ridge with its wings beating through three frames. The
        silhouette, horns, tail spade, and moon stay fixed while the wing changes shape.
      </p>
    </header>
    <div class="design-piece__stage">
      <AnimatedAscii
        client:visible
        frames={DRAGON_FRAMES}
        interval={700}
        start={1}
        label="ASCII art of a dragon flying over mountains"
        className="design-art"
      />
    </div>
    <footer class="design-piece__foot">
      <code>120 × 42 glyphs · 3 frames</code>
    </footer>
  </article>
</div>

<style>
  .design-gallery {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0 3rem;
  }

  .design-piece {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5, rgba(0, 0, 0, 0.15));
    background: #0b0d0f;
  }

  .design-piece__head {
    padding: 1.2rem 1.3rem 0;
  }

  .design-piece__meta {
    margin: 0 0 0.35rem;
    color: #ff7a1a;
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .design-piece h2 {
    margin: 0;
    color: #ece8df;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .design-piece__head p:last-child {
    max-width: 62ch;
    margin: 0.5rem 0 1rem;
    color: rgba(236, 232, 223, 0.6);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .design-piece__stage {
    overflow-x: auto;
    border-top: 1px solid rgba(236, 232, 223, 0.1);
    border-bottom: 1px solid rgba(236, 232, 223, 0.1);
    background:
      radial-gradient(circle at 50% 40%, rgba(255, 122, 26, 0.05), transparent 55%),
      #050607;
    padding: 1rem;
  }

  .design-piece__stage--webgl {
    height: 380px;
    padding: 0;
    background: #050607;
  }

  .design-piece__stage--webgl :global(canvas) {
    display: block;
    width: 100%;
    height: 100% !important;
  }

  .design-art {
    width: max-content;
    margin: 0 auto;
    color: #e8e0cd;
    font-family: var(--sl-font-mono);
    font-size: clamp(4.5px, 1.1vw, 8.5px);
    line-height: 1;
    letter-spacing: 0;
    text-align: left;
    text-shadow: 0 0 10px rgba(255, 122, 26, 0.08);
    white-space: pre;
  }

  .design-piece__foot {
    padding: 0.7rem 1.3rem;
  }

  .design-piece__foot code {
    color: rgba(236, 232, 223, 0.45);
    font-size: 0.62rem;
  }

  @media (max-width: 42rem) {
    .design-piece__stage {
      padding: 0.65rem;
    }

    .design-piece__stage--webgl {
      height: 300px;
    }

    .design-art {
      font-size: clamp(3.2px, 0.8vw, 4.8px);
    }
  }
</style>
