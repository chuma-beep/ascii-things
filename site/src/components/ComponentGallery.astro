---
import FooterThumb from "@components/FooterThumb.astro";
import {
  ConsoleThumb,
  DitherThumb,
  KoiThumb,
  SurfaceThumb,
  ToolbarThumb,
} from "@components/ComponentThumbs";

const registryBase = "https://ascii-things-docs.pages.dev/r";

const cards = [
  {
    id: "koi-card",
    category: "cards",
    eyebrow: "Card",
    title: "Koi card",
    description: "A shadcn card with a live koi pond and a re-seed control.",
    install: `npx shadcn@latest add ${registryBase}/koi-card.json`,
    href: "/components/koi-card/",
  },
  {
    id: "dither-card",
    category: "cards",
    eyebrow: "Card",
    title: "Dither card",
    description: "An ordered-dither wordmark inside a shadcn card.",
    install: `npx shadcn@latest add ${registryBase}/dither-card.json`,
    href: "/components/dither-card/",
  },
  {
    id: "surface-card",
    category: "cards",
    eyebrow: "Card",
    title: "Surface card",
    description: "A shader-backed ASCII glyph field with a density toggle.",
    install: `npx shadcn@latest add ${registryBase}/surface-card.json`,
    href: "/components/surface-card/",
  },
  {
    id: "scene-console",
    category: "scenes",
    eyebrow: "Composition",
    title: "Scene console",
    description: "Stage, palette tabs, command prompt, and live readout.",
    install: `npx shadcn@latest add ${registryBase}/scene-console.json`,
    href: "/components/scene-console/",
  },
  {
    id: "scene-toolbar",
    category: "scenes",
    eyebrow: "Composition",
    title: "Scene toolbar",
    description: "Panel, toolbar, toggle, buttons, divider, and status row.",
    install: `npx shadcn@latest add ${registryBase}/scene-toolbar.json`,
    href: "/components/scene-toolbar/",
  },
  {
    id: "ascii-box-footer",
    category: "backgrounds",
    eyebrow: "Background",
    title: "ASCII box footer",
    description: "A continuous box lattice with a slow accent scan.",
    install: `npx shadcn@latest add ${registryBase}/ascii-box-footer.json`,
    href: "/components/ascii-box-footer/",
  },
] as const;
---

<section class="component-catalog" aria-labelledby="component-catalog-title">
  <div class="component-catalog__heading">
    <p class="component-catalog__eyebrow">Registry</p>
    <h2 id="component-catalog-title">Browse the components.</h2>
    <p>
      Six copyable shadcn items. Preview one, copy the install command, or open the full page for
      composition notes and source.
    </p>
  </div>

  <div class="component-catalog__filters" role="group" aria-label="Filter components">
    <button class="catalog-filter is-active" type="button" data-filter="all" aria-pressed="true">
      All <span>6</span>
    </button>
    <button class="catalog-filter" type="button" data-filter="cards" aria-pressed="false">
      Cards &amp; surfaces <span>3</span>
    </button>
    <button class="catalog-filter" type="button" data-filter="scenes" aria-pressed="false">
      Scenes &amp; controls <span>2</span>
    </button>
    <button class="catalog-filter" type="button" data-filter="backgrounds" aria-pressed="false">
      Backgrounds <span>1</span>
    </button>
  </div>

  <div class="component-catalog__grid">
    <article class="catalog-card" data-category="cards">
      <a class="catalog-card__preview" href="/components/koi-card/" aria-label="Open Koi card">
        <div class="catalog-card__fill">
          <KoiThumb client:load />
        </div>
      </a>
      <div class="catalog-card__body">
        <div class="catalog-card__meta">
          <span class="catalog-card__eyebrow">Card</span>
          <span class="catalog-card__badge">Live scene</span>
        </div>
        <h3><a href="/components/koi-card/">Koi card</a></h3>
        <p>A shadcn card with a live koi pond and a re-seed control.</p>
        <div class="catalog-card__actions">
          <a class="catalog-card__open" href="/components/koi-card/">View component ↗</a>
          <button class="catalog-card__copy" type="button" data-copy={cards[0].install}>Copy install</button>
        </div>
      </div>
    </article>

    <article class="catalog-card" data-category="cards">
      <a class="catalog-card__preview" href="/components/dither-card/" aria-label="Open Dither card">
        <div class="catalog-card__fill">
          <DitherThumb client:load />
        </div>
      </a>
      <div class="catalog-card__body">
        <div class="catalog-card__meta">
          <span class="catalog-card__eyebrow">Card</span>
          <span class="catalog-card__badge">Canvas</span>
        </div>
        <h3><a href="/components/dither-card/">Dither card</a></h3>
        <p>An ordered-dither wordmark inside a shadcn card.</p>
        <div class="catalog-card__actions">
          <a class="catalog-card__open" href="/components/dither-card/">View component ↗</a>
          <button class="catalog-card__copy" type="button" data-copy={cards[1].install}>Copy install</button>
        </div>
      </div>
    </article>

    <article class="catalog-card" data-category="cards">
      <a class="catalog-card__preview" href="/components/surface-card/" aria-label="Open Surface card">
        <div class="catalog-card__fill">
          <SurfaceThumb client:load />
        </div>
      </a>
      <div class="catalog-card__body">
        <div class="catalog-card__meta">
          <span class="catalog-card__eyebrow">Card</span>
          <span class="catalog-card__badge">WebGL</span>
        </div>
        <h3><a href="/components/surface-card/">Surface card</a></h3>
        <p>A shader-backed ASCII glyph field with a density toggle.</p>
        <div class="catalog-card__actions">
          <a class="catalog-card__open" href="/components/surface-card/">View component ↗</a>
          <button class="catalog-card__copy" type="button" data-copy={cards[2].install}>Copy install</button>
        </div>
      </div>
    </article>

    <article class="catalog-card" data-category="scenes">
      <a class="catalog-card__preview" href="/components/scene-console/" aria-label="Open Scene console">
        <div class="catalog-card__fill catalog-card__fill--stage">
          <ConsoleThumb client:load />
        </div>
      </a>
      <div class="catalog-card__body">
        <div class="catalog-card__meta">
          <span class="catalog-card__eyebrow">Composition</span>
          <span class="catalog-card__badge">Interactive</span>
        </div>
        <h3><a href="/components/scene-console/">Scene console</a></h3>
        <p>Stage, palette tabs, command prompt, and live readout.</p>
        <div class="catalog-card__actions">
          <a class="catalog-card__open" href="/components/scene-console/">View component ↗</a>
          <button class="catalog-card__copy" type="button" data-copy={cards[3].install}>Copy install</button>
        </div>
      </div>
    </article>

    <article class="catalog-card" data-category="scenes">
      <a class="catalog-card__preview" href="/components/scene-toolbar/" aria-label="Open Scene toolbar">
        <div class="catalog-card__fill catalog-card__fill--panel">
          <ToolbarThumb client:load />
        </div>
      </a>
      <div class="catalog-card__body">
        <div class="catalog-card__meta">
          <span class="catalog-card__eyebrow">Composition</span>
          <span class="catalog-card__badge">Interactive</span>
        </div>
        <h3><a href="/components/scene-toolbar/">Scene toolbar</a></h3>
        <p>Panel, toolbar, toggle, buttons, divider, and status row.</p>
        <div class="catalog-card__actions">
          <a class="catalog-card__open" href="/components/scene-toolbar/">View component ↗</a>
          <button class="catalog-card__copy" type="button" data-copy={cards[4].install}>Copy install</button>
        </div>
      </div>
    </article>

    <article class="catalog-card" data-category="backgrounds">
      <a class="catalog-card__preview" href="/components/ascii-box-footer/" aria-label="Open ASCII box footer">
        <FooterThumb />
      </a>
      <div class="catalog-card__body">
        <div class="catalog-card__meta">
          <span class="catalog-card__eyebrow">Background</span>
          <span class="catalog-card__badge">Canvas</span>
        </div>
        <h3><a href="/components/ascii-box-footer/">ASCII box footer</a></h3>
        <p>A continuous box lattice with a slow accent scan.</p>
        <div class="catalog-card__actions">
          <a class="catalog-card__open" href="/components/ascii-box-footer/">View component ↗</a>
          <button class="catalog-card__copy" type="button" data-copy={cards[5].install}>Copy install</button>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".catalog-filter");
  const cards = document.querySelectorAll<HTMLElement>(".catalog-card");

  const applyFilter = (filter: string) => {
    filters.forEach((button) => {
      const active = button.dataset.filter === filter;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    cards.forEach((card) => {
      card.hidden = filter !== "all" && card.dataset.category !== filter;
    });
  };

  filters.forEach((button) => {
    button.addEventListener("click", () => applyFilter(button.dataset.filter ?? "all"));
  });

  document.querySelectorAll<HTMLButtonElement>(".catalog-card__copy").forEach((button) => {
    button.addEventListener("click", async () => {
      const command = button.dataset.copy;
      if (!command) return;
      try {
        await navigator.clipboard.writeText(command);
        const original = button.textContent;
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = original;
        }, 1600);
      } catch {
        button.textContent = "Copy failed";
      }
    });
  });
</script>

<style>
  .component-catalog {
    margin: 1.5rem 0 2.5rem;
  }

  .component-catalog__heading {
    max-width: 42rem;
    margin-bottom: 1.2rem;
  }

  .component-catalog__eyebrow {
    margin: 0 0 0.45rem;
    color: var(--sl-color-accent);
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .component-catalog__heading h2 {
    margin: 0 0 0.55rem;
    color: var(--sl-color-white);
    font-size: clamp(1.45rem, 3vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .component-catalog__heading p:last-child {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .component-catalog__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .catalog-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }

  .catalog-filter span {
    color: var(--sl-color-gray-4);
  }

  .catalog-filter:hover,
  .catalog-filter.is-active {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
    color: var(--sl-color-white);
  }

  .catalog-filter.is-active span {
    color: var(--sl-color-accent);
  }

  .component-catalog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .catalog-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    background: #0b0d0f;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  .catalog-card:hover {
    border-color: var(--sl-color-gray-4);
    transform: translateY(-2px);
  }

  .catalog-card[hidden] {
    display: none;
  }

  .catalog-card__preview {
    display: block;
    height: 11.5rem;
    overflow: hidden;
    border-bottom: 1px solid rgba(236, 232, 223, 0.1);
    background: #050607;
  }

  .catalog-card__fill {
    height: 100%;
  }

  .catalog-card__fill :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .catalog-card__fill--stage,
  .catalog-card__fill--panel {
    padding: 0.55rem;
  }

  .catalog-card__fill--stage :global(.ascii-stage),
  .catalog-card__fill--panel :global(.ascii-panel) {
    height: 100%;
    margin: 0;
  }

  .catalog-card__fill--stage :global(.ascii-stage-frame) {
    height: 100%;
  }

  .catalog-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.8rem 0.85rem 0.75rem;
  }

  .catalog-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }

  .catalog-card__eyebrow {
    color: var(--sl-color-accent);
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .catalog-card__badge {
    border: 1px solid var(--sl-color-gray-5);
    padding: 0.2rem 0.35rem;
    color: var(--sl-color-gray-4);
    font-family: var(--sl-font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .catalog-card h3 {
    margin: 0 0 0.3rem;
    color: var(--sl-color-white);
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }

  .catalog-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .catalog-card p {
    margin: 0 0 0.8rem;
    color: var(--sl-color-gray-3);
    font-size: 0.74rem;
    line-height: 1.6;
  }

  .catalog-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(236, 232, 223, 0.08);
  }

  .catalog-card__open,
  .catalog-card__copy {
    color: var(--sl-color-gray-4);
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .catalog-card__open:hover,
  .catalog-card__copy:hover {
    color: var(--sl-color-white);
  }

  .catalog-card__copy {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @media (max-width: 72rem) {
    .component-catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 42rem) {
    .component-catalog__grid {
      grid-template-columns: 1fr;
    }

    .catalog-card__preview {
      height: 12rem;
    }
  }
</style>
