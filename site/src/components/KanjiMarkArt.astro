---
import type { KanjiMark } from "../data/kanji";

interface Props {
  mark: KanjiMark["id"];
}

const { mark } = Astro.props;
const kanjiFont = "'Noto Serif CJK JP', 'Yu Mincho', 'Hiragino Mincho ProN', serif";
---

<div class="kanji-mark-art" style={`--kanji-font: ${kanjiFont}`}>
  {
    mark === "seal" ? (
      <div
        class="hanko"
        role="img"
        aria-label="Hanko seal with the characters 永, 龍, 風, and 水"
      >
        <span>永</span>
        <span>龍</span>
        <span>風</span>
        <span>水</span>
      </div>
    ) : (
      <div
        class="scroll"
        role="img"
        aria-label="Vertical scroll with 春夏秋冬 and a 寿 seal"
      >
        <p class="scroll__text">春夏秋冬</p>
        <span class="scroll__seal">寿</span>
      </div>
    )
  }
</div>

<style>
  .kanji-mark-art {
    display: grid;
    place-items: center;
    font-family: var(--kanji-font);
  }

  .hanko {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    place-items: center;
    width: clamp(150px, 32vw, 190px);
    aspect-ratio: 1;
    padding: 0.7rem;
    border: 2px solid #f4ead6;
    background: #a8342b;
    color: #f7efe2;
    font-family: var(--kanji-font);
    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 1;
    box-shadow:
      inset 0 0 0 4px rgba(0, 0, 0, 0.16),
      0 18px 40px rgba(0, 0, 0, 0.38);
    transform: rotate(-3deg);
    animation: hanko-press 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hanko span {
    display: block;
  }

  .scroll {
    position: relative;
    width: clamp(110px, 24vw, 150px);
    height: clamp(190px, 40vw, 250px);
    padding: 1rem 0.9rem;
    border: 1px solid #d9cdb9;
    background: linear-gradient(90deg, #efe3cc, #f8f0df 38%, #efe3cc);
    color: #1b1a17;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    transform: rotate(2deg);
    animation: scroll-rise 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .scroll__text {
    margin: 0;
    font-family: var(--kanji-font);
    font-size: clamp(1.7rem, 5vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: 0.14em;
    writing-mode: vertical-rl;
    text-orientation: upright;
  }

  .scroll__seal {
    position: absolute;
    right: 0.75rem;
    bottom: 0.85rem;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    background: #a8342b;
    color: #f7efe2;
    font-family: var(--kanji-font);
    font-size: 0.9rem;
  }

  @keyframes hanko-press {
    0% {
      opacity: 0;
      transform: scale(1.12) rotate(-6deg);
    }
    65% {
      opacity: 1;
      transform: scale(0.97) rotate(-2deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(-3deg);
    }
  }

  @keyframes scroll-rise {
    0% {
      opacity: 0;
      transform: translateY(10px) rotate(3deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(2deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanko,
    .scroll {
      animation: none;
    }
  }
</style>
