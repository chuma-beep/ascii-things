---
import { AsciiSurface } from "ascii-things/webgl/react";
import CopyCode from "./CopyCode.astro";
import KanjiMarkArt from "./KanjiMarkArt.astro";
import { KANJI_MARKS } from "../data/kanji";

interface Props {
  showHelix?: boolean;
}

const { showHelix = false } = Astro.props;
const kanjiFont = "'Noto Serif CJK JP', 'Yu Mincho', 'Hiragino Mincho ProN', serif";
---

<div
  class:list={["kanji-marks", { "kanji-marks--three": showHelix }]}
  style={`--kanji-font: ${kanjiFont}`}
>
  {
    showHelix && (
      <article class="kanji-mark" id="helix">
        <div class="kanji-mark__stage kanji-mark__stage--webgl">
          <AsciiSurface
            client:visible
            variant="helix-3d"
            text=""
            glyphs="龍神光"
            density={0.5}
            cell={12}
            pointer={false}
            foreground="#c7e8a4"
            accent="#7ee787"
            fontFamily={kanjiFont}
            label="Kanji helix ASCII demo"
            style={{ height: "280px" }}
          />
        </div>
        <div class="kanji-mark__body">
          <p class="kanji-mark__family">Live 3D</p>
          <h2>
            <a href="/kanji/helix-3d/">Kanji helix</a>
          </h2>
          <p class="kanji-mark__description">
            A double helix turning through a field of bright characters.
          </p>
          <div class="kanji-mark__actions">
            <CopyCode value="龍神光" display="WEBGL · 龍神光" label="Kanji helix" />
            <a class="kanji-mark__open" href="/kanji/helix-3d/">Open study ↗</a>
          </div>
        </div>
      </article>
    )
  }

  {
    KANJI_MARKS.map((mark) => (
      <article class="kanji-mark" id={mark.id}>
        <div class="kanji-mark__stage">
          <KanjiMarkArt mark={mark.id} />
        </div>
        <div class="kanji-mark__body">
          <p class="kanji-mark__family">{mark.family}</p>
          <h2>
            <a href={`/kanji/${mark.slug}/`}>{mark.title}</a>
          </h2>
          <p class="kanji-mark__description">{mark.description}</p>
          <div class="kanji-mark__actions">
            <CopyCode value={mark.copy ?? mark.code} display={mark.code} label={mark.title} />
            <a class="kanji-mark__open" href={`/kanji/${mark.slug}/`}>
              Open study ↗
            </a>
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .kanji-marks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }

  .kanji-marks--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .kanji-mark {
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1rem);
    overflow: hidden;
    border: 1px solid rgba(236, 232, 223, 0.16);
    background: #0b0d0f;
  }

  .kanji-mark__stage {
    display: grid;
    place-items: center;
    height: 280px;
    overflow: hidden;
    border-bottom: 1px solid rgba(236, 232, 223, 0.1);
    background:
      radial-gradient(circle at 50% 42%, rgba(255, 122, 26, 0.08), transparent 58%),
      #050607;
  }

  .kanji-mark__stage--webgl {
    background: #050607;
  }

  .kanji-mark__stage--webgl :global(canvas) {
    display: block;
    width: 100%;
    height: 280px !important;
  }

  .kanji-mark__body {
    padding: 0.9rem 1rem 1rem;
  }

  .kanji-mark__family {
    margin: 0 0 0.35rem;
    color: #ff7a1a;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .kanji-mark h2 {
    margin: 0;
    color: #ece8df;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .kanji-mark h2 a {
    color: inherit;
    text-decoration: none;
  }

  .kanji-mark h2 a:hover {
    color: #ff7a1a;
  }

  .kanji-mark__description {
    min-height: 3.8em;
    margin: 0.45rem 0 0.7rem;
    color: rgba(236, 232, 223, 0.58);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .kanji-mark__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kanji-mark__actions :global(.copy-code) {
    flex: 1;
    min-width: 0;
  }

  .kanji-mark__open {
    flex: none;
    color: #ff7a1a;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .kanji-mark__open:hover {
    color: #ffd7a8;
  }

  @media (max-width: 72rem) {
    .kanji-marks {
      grid-template-columns: 1fr;
    }
  }
</style>
