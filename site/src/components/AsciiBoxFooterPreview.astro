---
---

<div class="box-footer-preview">
  <canvas data-ascii-box-preview aria-hidden="true"></canvas>
  <div class="box-footer-preview__content">
    <div class="box-footer-preview__top">
      <span class="box-footer-preview__brand">ascii-things<span>®</span></span>
      <span class="box-footer-preview__note">ASCII box footer · registry component</span>
    </div>
    <div class="box-footer-preview__links">
      <span>npm ↗</span>
      <span>GitHub ↗</span>
      <span>Playground ↗</span>
      <span>MIT</span>
    </div>
  </div>
  <div class="box-footer-preview__art" aria-hidden="true">ASCII-THINGS</div>
</div>

<script>
  import { createAsciiBoxFooter } from "../../../examples/ascii-box-footer/ascii-box-footer";

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>("[data-ascii-box-preview]")) {
    createAsciiBoxFooter(canvas, { size: 9 });
  }
</script>

<style>
  .box-footer-preview {
    position: relative;
    min-height: clamp(19rem, 40vw, 26rem);
    margin: 1.75rem 0 2.5rem;
    overflow: hidden;
    border: 1px solid rgba(236, 232, 223, 0.16);
    background:
      radial-gradient(70% 90% at 50% 118%, rgba(255, 122, 26, 0.08), transparent 62%), #050607;
  }

  .box-footer-preview canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .box-footer-preview__content {
    position: relative;
    z-index: 2;
    padding: clamp(1.1rem, 3vw, 1.75rem);
  }

  .box-footer-preview__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid rgba(236, 232, 223, 0.12);
  }

  .box-footer-preview__brand {
    color: #ece8df;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .box-footer-preview__brand span {
    color: #ff7a1a;
    font-size: 0.45rem;
    vertical-align: super;
  }

  .box-footer-preview__note {
    color: rgba(236, 232, 223, 0.38);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
  }

  .box-footer-preview__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    padding-top: 0.95rem;
    color: rgba(236, 232, 223, 0.55);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .box-footer-preview__art {
    position: absolute;
    bottom: 0.35rem;
    left: 50%;
    z-index: 1;
    width: max-content;
    transform: translateX(-50%);
    color: transparent;
    font-family: var(--sl-font-mono);
    font-size: clamp(2.4rem, 8vw, 5.2rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.72;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    background: linear-gradient(
      180deg,
      rgba(255, 122, 26, 0.62) 0%,
      rgba(255, 122, 26, 0.24) 58%,
      rgba(255, 122, 26, 0.08) 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-stroke: 1px rgba(255, 122, 26, 0.55);
    filter: drop-shadow(0 0 42px rgba(255, 122, 26, 0.16));
  }

  @media (max-width: 42rem) {
    .box-footer-preview__top {
      display: grid;
    }

    .box-footer-preview__note {
      text-align: left;
    }
  }
</style>
