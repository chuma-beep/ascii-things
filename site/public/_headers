/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Allow embedding in a portfolio or other demo. Narrow the source list
  # (for example `frame-ancestors https://example.com`) if clickjacking
  # protection matters more than broad embeddability.
  Content-Security-Policy: frame-ancestors *

/designs
  Cache-Control: no-store

/designs/*
  Cache-Control: no-store

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
