      "registryDependencies": ["card", "badge"],
      "files": [
        {
          "path": "registry/dither-card.tsx",
          "type": "registry:component",
          "target": "components/dither-card.tsx"
        }
      ]
    },
    {
      "name": "surface-card",
      "type": "registry:component",
      "title": "Surface card",
      "description": "A shadcn card with a shader-backed ASCII glyph surface and a density toggle.",
      "dependencies": ["ascii-things"],
      "registryDependencies": ["card", "badge", "button"],
      "files": [
        {
          "path": "registry/surface-card.tsx",
          "type": "registry:component",
          "target": "components/surface-card.tsx"
        }
      ]
    }
  ]
