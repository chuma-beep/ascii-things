{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ascii-things",
  "homepage": "https://ascii-things-docs.pages.dev",
  "items": [
    {
      "name": "ascii-box-footer",
      "type": "registry:lib",
      "title": "ASCII box footer",
      "description": "A framework-free canvas background made of a continuous ASCII box lattice with a slow accent scan.",
      "files": [
        {
          "path": "examples/ascii-box-footer/ascii-box-footer.ts",
          "type": "registry:lib",
          "target": "lib/ascii-box-footer.ts"
        }
      ]
    },
    {
      "name": "koi-card",
