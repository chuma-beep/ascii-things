      "registryDependencies": ["card", "badge", "button"],
      "files": [
        {
          "path": "registry/koi-card.tsx",
          "type": "registry:component",
          "target": "components/koi-card.tsx"
        }
      ]
    },
    {
      "name": "dither-card",
      "type": "registry:component",
